// Copy to `Local.xcconfig` (gitignored) and replace the four values with the client ids issued
// for your own GCP project. Each app is an *iOS-type* client; the reversed id is the client id
// with its two halves swapped around `com.googleusercontent.apps.`.

RECLY_PHONE_GID_CLIENT_ID = 1234567890-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
RECLY_PHONE_GID_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

RECLY_MAC_GID_CLIENT_ID = 1234567890-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.apps.googleusercontent.com
RECLY_MAC_GID_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

// docs/03 "Storage location": iCloud, once iCloud.app.recly is registered for your team (Certificates,
// Identifiers & Profiles → Identifiers → iCloud Containers) and the iCloud capability with that
// container is enabled on the app.recly and app.recly.mac App IDs. The Mac's Release build also
// needs a Developer ID provisioning profile for app.recly.mac that includes it — named here.
// RECLY_ICLOUD_CONTAINER = iCloud.app.recly
// RECLY_PHONE_ENTITLEMENTS = RecPhone/RecPhone-iCloud.entitlements
// RECLY_MAC_ENTITLEMENTS[config=Release] = RecMac/RecMac-iCloud.entitlements
// RECLY_MAC_PROFILE[config=Release] = Recly Mac Developer ID
