        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्शन बिना टेक्स्ट पूरा हुआ। ऑडियो जाँचने के लिए रिकॉर्डिंग चलाएँ।"
