          "stringUnit": {
            "state": "translated",
            "value": "ElevenLabsは、ElevenLabsアカウントでこの設定をオフにしない限り、録音をモデルの改善に使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非您在ElevenLabs账号中关闭此设置，否则ElevenLabs会使用录音改进其模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非您在ElevenLabs帳戶中關閉此設定，否則ElevenLabs會使用錄音改進其模型。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ElevenLabs usa las grabaciones para mejorar sus modelos, salvo que lo desactives en tu cuenta de ElevenLabs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ElevenLabs utilise les enregistrements pour améliorer ses modèles, sauf si vous le désactivez dans votre compte ElevenLabs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ElevenLabs verwendet Aufnahmen zur Verbesserung seiner Modelle, sofern Sie dies nicht in Ihrem ElevenLabs-Konto deaktivieren."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم ElevenLabs التسجيلات لتحسين نماذجها ما لم يتم إيقاف ذلك في حسابك على ElevenLabs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप अपने ElevenLabs खाते में इसे बंद नहीं करते, ElevenLabs रिकॉर्डिंग का उपयोग अपने मॉडल सुधारने के लिए करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ElevenLabs использует записи для улучшения своих моделей, если это не отключено в вашем аккаунте ElevenLabs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ElevenLabs usa as gravações para melhorar seus modelos, a menos que isso seja desativado na sua conta ElevenLabs."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ElevenLabs utiliza as gravações para melhorar os respetivos modelos, exceto se desativar esta opção na sua conta ElevenLabs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ElevenLabs usa le registrazioni per migliorare i propri modelli, a meno che tu non lo disattivi nel tuo account ElevenLabs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ElevenLabs używa nagrań do ulepszania swoich modeli, chyba że ta opcja jest wyłączona na Twoim koncie ElevenLabs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ElevenLabs hesabınızda kapatılmadığı sürece ElevenLabs, kayıtları modellerini geliştirmek için kullanır."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit ng ElevenLabs ang mga recording para pahusayin ang mga modelo nito maliban kung naka-off ito sa iyong ElevenLabs account."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ElevenLabs অ্যাকাউন্টে এটি বন্ধ না করলে ElevenLabs তার মডেল উন্নত করতে রেকর্ডিং ব্যবহার করে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک آپ اپنے ElevenLabs اکاؤنٹ میں اسے آف نہ کریں، ElevenLabs اپنے ماڈلز بہتر بنانے کے لیے ریکارڈنگز استعمال کرتا ہے۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "ElevenLabs hutumia rekodi kuboresha modeli zake isipokuwa uzime hili kwenye akaunti yako ya ElevenLabs."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ElevenLabs dùng bản ghi âm để cải thiện mô hình của họ, trừ khi bạn tắt tùy chọn này trong tài khoản ElevenLabs."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر این گزینه در حساب ElevenLabs شما خاموش نشده باشد، ElevenLabs از ضبط‌ها برای بهبود مدل‌هایش استفاده می‌کند."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ElevenLabs ใช้การบันทึกเสียงเพื่อปรับปรุงโมเดลของตน เว้นแต่คุณจะปิดการตั้งค่านี้ในบัญชี ElevenLabs ของคุณ"
          }
        }
      }
    },
