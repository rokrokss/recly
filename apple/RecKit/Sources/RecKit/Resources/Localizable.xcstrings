    "alert.localDiarization": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This local engine does not support speaker identification. Turn it off or choose an external API."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로컬 엔진은 화자 구분을 지원하지 않습니다. 화자 구분을 끄거나 외부 API를 선택해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このローカルエンジンは話者識別に対応していません。無効にするか、外部APIを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此本地引擎不支持说话人识别。请关闭该功能或选择外部API。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此本機引擎不支援說話者識別。請關閉該功能或選擇外部API。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este motor local no identifica hablantes. Desactiva la función o elige una API externa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce moteur local n’identifie pas les locuteurs. Désactivez cette option ou choisissez une API externe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese lokale Engine unterstützt keine Sprechererkennung. Deaktivieren Sie sie oder wählen Sie eine externe API."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المحرك المحلي لا يدعم تحديد المتحدثين. عطّل الميزة أو اختر API خارجيًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्थानीय इंजन वक्ता पहचान का समर्थन नहीं करता। इसे बंद करें या बाहरी API चुनें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот локальный движок не распознаёт говорящих. Выключите эту функцию или выберите внешний API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mecanismo local não identifica falantes. Desative a função ou escolha uma API externa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este motor local não suporta a identificação de oradores. Desative-a ou escolha uma API externa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo motore locale non supporta l’identificazione degli interlocutori. Disattivala o scegli un’API esterna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten lokalny silnik nie obsługuje rozpoznawania mówców. Wyłącz tę opcję lub wybierz zewnętrzne API."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerel motor konuşmacı tanımlamayı desteklemiyor. Bu özelliği kapatın veya harici bir API seçin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sinusuportahan ng lokal na engine na ito ang pagkilala sa nagsasalita. I-off ito o pumili ng external na API."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লোকাল ইঞ্জিন বক্তা শনাক্তকরণ সমর্থন করে না। এটি বন্ধ করুন অথবা একটি বাহ্যিক API বেছে নিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ مقامی انجن بولنے والوں کی شناخت کو سپورٹ نہیں کرتا۔ اسے آف کریں یا کوئی بیرونی API منتخب کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Injini hii ya ndani haitumii utambuzi wa wazungumzaji. Zima kipengele hicho au uchague API ya nje."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ cục bộ này không hỗ trợ nhận dạng người nói. Hãy tắt tùy chọn này hoặc chọn API bên ngoài."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این موتور محلی از تشخیص گوینده پشتیبانی نمی‌کند. آن را خاموش کنید یا یک API خارجی انتخاب کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอนจินในเครื่องนี้ไม่รองรับการระบุผู้พูด ปิดการระบุผู้พูดหรือเลือก API ภายนอก"
          }
        }
      }
    },
