    "This transcription provider is unavailable in your App Store region.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This transcription provider is unavailable in your App Store region."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 전사 제공업체는 현재 App Store 지역에서 사용할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文字起こし提供者は、お使いのApp Storeの地域では利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此转录提供商在您的App Store地区不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此轉錄供應商在您的App Store地區無法使用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proveedor no está disponible en tu región de App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur est indisponible dans votre région App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Transkriptionsanbieter ist in Ihrer App-Store-Region nicht verfügbar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este provedor não está disponível na sua região da App Store."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزوّد النسخ هذا غير متاح في منطقة App Store لديك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ट्रांसक्रिप्शन प्रदाता आपके App Store क्षेत्र में उपलब्ध नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот провайдер расшифровки недоступен в вашем регионе App Store."
          }
        }
      }
    },
    "Waiting to verify your App Store region before continuing transcription.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting to verify your App Store region before continuing transcription."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사를 계속하기 전에 App Store 지역 확인을 기다리고 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしを続ける前に、App Storeの地域を確認しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待验证App Store地区，以继续转录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待驗證App Store地區，以繼續轉錄。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a verificar tu región de App Store para continuar la transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de votre région App Store avant de poursuivre la transcription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Prüfung Ihrer App-Store-Region, bevor die Transkription fortgesetzt wird."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando a verificação da região da App Store para continuar a transcrição."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
