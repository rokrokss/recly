    "provider.disclosure.transcribe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External transcription sends the whole recording to %@.\nHow long they keep it, and whether they train on it, is that provider's own policy — Recly does not control it.\nRead the provider's policy before you use it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 전사는 녹음 오디오 전체를 %@에 보냅니다.\n얼마나 보관하는지, 학습에 쓰는지는 그 업체의 정책이고 Recly가 통제하지 못합니다.\n쓰기 전에 업체의 정책을 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部の文字起こしでは、録音全体を%@に送信します。\n保存期間や学習への利用は提供者のポリシーによって決まり、Reclyは管理できません。\n使用前に提供者のポリシーをお読みください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外部转录会将完整录音发送给%@。\n保留期限以及是否用于训练由提供商政策决定，Recly无法控制。\n使用前请阅读提供商政策。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外部轉錄會將完整錄音傳送給%@。\n保留期限以及是否用於訓練由供應商政策決定，Recly無法控制。\n使用前請閱讀供應商政策。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción externa envía la grabación completa a %@.\nLa conservación y el uso para entrenamiento dependen de su política; Recly no los controla.\nLee la política del proveedor antes de usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription externe envoie l’enregistrement complet à %@.\nLa conservation et l’utilisation pour l’entraînement dépendent de sa politique ; Recly ne les contrôle pas.\nLisez la politique du fournisseur avant de l’utiliser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die externe Transkription sendet die gesamte Aufnahme an %@.\nSpeicherdauer und Nutzung für Training bestimmt dessen Richtlinie. Recly kontrolliert dies nicht.\nLesen Sie die Richtlinie des Anbieters vor der Nutzung."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل النسخ الخارجي التسجيل كاملًا إلى %@.\nتعتمد مدة الاحتفاظ والاستخدام للتدريب على سياسة المزوّد ولا يتحكم Recly بهما.\nاقرأ سياسة المزوّد قبل الاستخدام."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाहरी ट्रांसक्रिप्शन पूरी रिकॉर्डिंग %@ को भेजता है।\nकितने समय तक रखी जाएगी और प्रशिक्षण में उपयोग होगी या नहीं, यह प्रदाता की नीति है; Recly इसे नियंत्रित नहीं करता।\nउपयोग से पहले प्रदाता की नीति पढ़ें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внешняя расшифровка отправляет всю запись в %@.\nСрок хранения и использование для обучения зависят от его политики. Recly это не контролирует.\nПеред использованием прочтите политику провайдера."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição externa envia a gravação inteira para %@.\nA retenção e o uso para treinamento dependem da política dele; o Recly não os controla.\nLeia a política do provedor antes de usar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição externa envia a gravação completa para %@.\nO tempo de conservação e o eventual uso para treino dependem da política desse fornecedor — o Recly não os controla.\nLeia a política do fornecedor antes de o utilizar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione esterna invia l’intera registrazione a %@.\nPer quanto tempo la conserva e se la usa per l’addestramento dipende dall’informativa del fornitore: Recly non lo controlla.\nLeggi l’informativa del fornitore prima di usarlo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja zewnętrzna wysyła całe nagranie do %@.\nTo, jak długo je przechowuje i czy używa go do trenowania modeli, zależy od zasad tego dostawcy — Recly nie ma na to wpływu.\nPrzed użyciem zapoznaj się z zasadami dostawcy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harici transkripsiyon, kaydın tamamını %@ sağlayıcısına gönderir.\nKaydın ne kadar süre saklanacağı ve model eğitiminde kullanılıp kullanılmayacağı o sağlayıcının kendi politikasına bağlıdır — Recly bunu denetlemez.\nKullanmadan önce sağlayıcının politikasını okuyun."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapadala ng external na pag-transcribe ang buong recording sa %@.\nKung gaano katagal nila ito itatago, at kung gagamitin nila ito sa training, ay nakasalalay sa sariling patakaran ng provider — hindi ito kontrolado ng Recly.\nBasahin ang patakaran ng provider bago ito gamitin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাহ্যিক ট্রান্সক্রিপশন পুরো রেকর্ডিং %@-এর কাছে পাঠায়।\nতারা কতদিন এটি রাখবে এবং প্রশিক্ষণে ব্যবহার করবে কিনা, তা সেই প্রদানকারীর নিজস্ব নীতি; Recly এটি নিয়ন্ত্রণ করে না।\nব্যবহারের আগে প্রদানকারীর নীতি পড়ুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بیرونی ٹرانسکرپشن پوری ریکارڈنگ %@ کو بھیجتا ہے۔\nوہ اسے کتنی دیر رکھتے ہیں اور کیا اسے تربیت کے لیے استعمال کرتے ہیں، یہ اس فراہم کنندہ کی اپنی پالیسی ہے — Recly اسے کنٹرول نہیں کرتا۔\nاستعمال سے پہلے فراہم کنندہ کی پالیسی پڑھیں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unukuzi wa nje hutuma rekodi nzima kwa %@.\nMuda wa kuihifadhi, na iwapo itatumiwa kufunza modeli, hutegemea sera ya mtoa huduma huyo — Recly haidhibiti hilo.\nSoma sera ya mtoa huduma kabla ya kuitumia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chép lời bên ngoài sẽ gửi toàn bộ bản ghi âm đến %@.\nThời gian lưu giữ và việc có dùng để huấn luyện hay không là do chính sách riêng của nhà cung cấp đó — Recly không kiểm soát.\nHãy đọc chính sách của nhà cung cấp trước khi sử dụng."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رونویسی خارجی کل ضبط را به %@ می‌فرستد.\nمدت نگهداری آن و استفاده از آن برای آموزش، به خط‌مشی خود آن ارائه‌دهنده بستگی دارد؛ Recly کنترلی بر آن ندارد.\nپیش از استفاده، خط‌مشی ارائه‌دهنده را بخوانید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถอดเสียงภายนอกจะส่งการบันทึกเสียงทั้งหมดไปยัง %@\nระยะเวลาการเก็บรักษาและการนำไปใช้ฝึกโมเดลเป็นไปตามนโยบายของผู้ให้บริการรายนั้น Recly ไม่ได้เป็นผู้ควบคุม\nโปรดอ่านนโยบายของผู้ให้บริการก่อนใช้งาน"
          }
        }
      }
    },
    "soon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
