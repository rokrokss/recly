    "Recorded on another device. Deleting removes it from Drive and from every device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded on another device. Deleting removes it from Drive and from every device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 녹음한 것입니다. 지우면 Drive와 모든 기기에서 사라집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスで録音されました。削除すると、Driveとすべてのデバイスから削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制于其他设备。删除后将从Drive和所有设备中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製於其他裝置。刪除後將從Drive和所有裝置中移除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabado en otro dispositivo. Al eliminarlo se borra de Drive y de todos los dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré sur un autre appareil. La suppression le retire de Drive et de tous les appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
