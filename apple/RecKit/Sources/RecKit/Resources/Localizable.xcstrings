    },
    "Withdrawing permission stops future requests. It does not delete data already sent or your saved API keys.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdrawing permission stops future requests. It does not delete data already sent or your saved API keys."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용을 철회하면 이후 요청을 중단합니다. 이미 전송한 데이터나 저장된 API 키는 삭제되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可を取り消すと今後のリクエストが停止します。送信済みのデータや保存済みのAPIキーは削除されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销权限将停止后续请求，不会删除已发送的数据或保存的API密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷權限將停止後續請求，不會刪除已傳送的資料或儲存的API金鑰。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirar el permiso detiene futuras solicitudes. No elimina los datos ya enviados ni las claves API guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retrait bloque les futures requêtes. Les données déjà envoyées et les clés API enregistrées ne sont pas supprimées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Widerruf stoppt zukünftige Anfragen. Bereits gesendete Daten und gespeicherte API-Schlüssel werden nicht gelöscht."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revogar a permissão interrompe solicitações futuras. Não exclui dados já enviados nem chaves de API salvas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سحب الإذن يوقف الطلبات المستقبلية. لا يحذف البيانات المُرسلة أو مفاتيح API المحفوظة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति वापस लेने पर आगे के अनुरोध रुकेंगे। पहले भेजा डेटा या सहेजी API कुंजियाँ नहीं हटेंगी।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отзыв разрешения останавливает будущие запросы. Уже отправленные данные и сохранённые ключи API не удаляются."
          }
        }
      }
    },
