    "Saving updates the transcript files in your storage. It does not start your agent again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving updates the transcript files in your storage. It does not start your agent again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하면 저장소의 전사 파일이 바뀝니다. 에이전트를 다시 실행하지는 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると、保存先の文字起こしファイルが更新されます。エージェントは再実行されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后会更新存储位置中的转录文件。不会再次启动你的智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存後會更新儲存位置中的逐字稿檔案。不會再次啟動你的代理。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar se actualizan los archivos de transcripción en tu almacenamiento. Esto no vuelve a iniciar tu agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement met à jour les fichiers de transcription dans votre stockage. Il ne relance pas votre agent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Speichern werden die Transkriptdateien an Ihrem Speicherort aktualisiert. Ihr Agent wird dadurch nicht erneut gestartet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao salvar, os arquivos de transcrição no seu armazenamento são atualizados. Isso não inicia seu agente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao guardar, os ficheiros de transcrição no seu armazenamento são atualizados. Isto não volta a iniciar o seu agente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي الحفظ إلى تحديث ملفات النص في مكان التخزين لديك. ولا يعيد تشغيل وكيلك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजने पर आपके स्टोरेज में ट्रांसक्रिप्ट फ़ाइलें अपडेट हो जाती हैं। इससे आपका एजेंट फिर से शुरू नहीं होता।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При сохранении файлы расшифровки в вашем хранилище обновляются. Агент при этом повторно не запускается."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio aggiorna i file della trascrizione nel tuo spazio di archiviazione. Non riavvia il tuo agente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisanie aktualizuje pliki transkrypcji w Twoim miejscu przechowywania. Nie uruchamia ponownie Twojego agenta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmek, depolama alanınızdaki transkript dosyalarını günceller. Ajanınızı yeniden başlatmaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ina-update ng pag-save ang mga transcript file sa storage mo. Hindi nito sinisimulan ulit ang agent mo."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেভ করলে আপনার স্টোরেজের ট্রান্সক্রিপ্ট ফাইলগুলো আপডেট হয়। এতে আপনার এজেন্ট আবার চালু হয় না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ کرنے سے آپ کے اسٹوریج میں ٹرانسکرپٹ فائلیں اپ ڈیٹ ہو جاتی ہیں۔ اس سے آپ کا ایجنٹ دوبارہ شروع نہیں ہوتا۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuhifadhi kunasasisha faili za nakala kwenye hifadhi yako. Hakumwanzishi wakala wako tena."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi lưu, các tệp chép lời trong nơi lưu trữ của bạn sẽ được cập nhật. Thao tác này không chạy lại tác nhân của bạn."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با ذخیره، فایل‌های رونوشت در محل ذخیره‌سازی شما به‌روز می‌شوند. این کار عامل شما را دوباره اجرا نمی‌کند."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกจะอัปเดตไฟล์ข้อความถอดเสียงในที่จัดเก็บของคุณ แต่จะไม่เริ่มเอเจนต์ของคุณอีกครั้ง"
          }
        }
      }
    },
