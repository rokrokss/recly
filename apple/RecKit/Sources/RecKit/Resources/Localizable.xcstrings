    "Could not save a usable Drive connection. Try connecting again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save a usable Drive connection. Try connecting again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive 연결 정보를 저장하지 못했습니다. 다시 연결해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なDrive接続を保存できませんでした。もう一度接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存有效的Drive连接。请重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存有效的Drive連線。請重新連接。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar una conexión válida con Drive. Vuelve a conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer une connexion Drive valide. Reconnectez-vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine nutzbare Drive-Verbindung gespeichert. Bitte erneut verbinden."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ اتصال صالح بـDrive. حاول الربط مجددًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोग योग्य Drive कनेक्शन सहेजा नहीं जा सका। फिर कनेक्ट करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить рабочее подключение Drive. Подключитесь снова."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar uma conexão válida com o Drive. Conecte novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar uma ligação válida ao Drive. Tente ligar novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare un collegamento a Drive valido. Prova a collegarlo di nuovo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać działającego połączenia z Drive. Spróbuj połączyć ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılabilir bir Drive bağlantısı kaydedilemedi. Yeniden bağlanmayı deneyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-save ang magagamit na koneksyon sa Drive. Subukang kumonekta ulit."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যবহারযোগ্য Drive কানেকশন সেভ করা যায়নি। আবার কানেক্ট করার চেষ্টা করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قابل استعمال Drive کنکشن محفوظ نہیں ہو سکا۔ دوبارہ منسلک کرنے کی کوشش کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kuhifadhi muunganisho wa Drive unaoweza kutumika. Jaribu kuunganisha tena."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu kết nối Drive hợp lệ. Hãy thử kết nối lại."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال قابل‌استفاده‌ای به Drive ذخیره نشد. دوباره اتصال را امتحان کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการเชื่อมต่อ Drive ที่ใช้งานได้ไม่สำเร็จ ลองเชื่อมต่ออีกครั้ง"
          }
        }
      }
    },
    "Local transcription is unavailable on this device. Choose another transcription method.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local transcription is unavailable on this device. Choose another transcription method."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 로컬 전사를 사용할 수 없습니다. 전사 방식을 변경해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではローカル文字起こしを利用できません。別の方法を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不支持本地转录，请选择其他转录方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置不支援本機轉錄，請選擇其他轉錄方式。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción local no está disponible en este dispositivo. Elige otro método."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription locale est indisponible sur cet appareil. Choisissez une autre méthode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Transkription ist auf diesem Gerät nicht verfügbar. Wählen Sie eine andere Methode."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ المحلي غير متاح على هذا الجهاز. اختر طريقة أخرى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर स्थानीय ट्रांसक्रिप्शन उपलब्ध नहीं है। दूसरा तरीका चुनें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная расшифровка недоступна на этом устройстве. Выберите другой способ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição local não está disponível neste dispositivo. Escolha outro método."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição local não está disponível neste dispositivo. Escolha outro método de transcrição."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione locale non è disponibile su questo dispositivo. Scegli un altro metodo di trascrizione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalna transkrypcja jest niedostępna na tym urządzeniu. Wybierz inną metodę transkrypcji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel transkripsiyon bu cihazda kullanılamıyor. Başka bir transkripsiyon yöntemi seçin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi available ang lokal na pag-transcribe sa device na ito. Pumili ng ibang paraan ng pag-transcribe."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে লোকাল ট্রান্সক্রিপশন উপলভ্য নয়। অন্য কোনো ট্রান্সক্রিপশন পদ্ধতি বেছে নিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلے پر مقامی ٹرانسکرپشن دستیاب نہیں۔ ٹرانسکرپشن کا کوئی اور طریقہ منتخب کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unukuzi wa ndani haupatikani kwenye kifaa hiki. Chagua njia nyingine ya unukuzi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chép lời cục bộ trên thiết bị này. Hãy chọn phương thức chép lời khác."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رونویسی محلی در این دستگاه در دسترس نیست. روش رونویسی دیگری انتخاب کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถอดเสียงในเครื่องใช้ไม่ได้บนอุปกรณ์นี้ เลือกวิธีถอดเสียงอื่น"
          }
        }
      }
    },
    "The speech recognition model isn't downloaded yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The speech recognition model isn't downloaded yet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 인식 모델을 아직 다운로드하지 않았습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識モデルはまだダウンロードされていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未下载语音识别模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未下載語音辨識模型。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de reconocimiento de voz aún no se ha descargado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle de reconnaissance vocale n’est pas encore téléchargé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spracherkennungsmodell ist noch nicht heruntergeladen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تنزيل نموذج التعرّف على الكلام بعد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पीच रिकग्निशन मॉडल अभी डाउनलोड नहीं हुआ है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель распознавания речи ещё не загружена."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de reconhecimento de fala ainda não foi baixado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de reconhecimento de voz ainda não foi transferido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello di riconoscimento vocale non è ancora stato scaricato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model rozpoznawania mowy nie został jeszcze pobrany."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma tanıma modeli henüz indirilmedi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa na-download ang modelo ng speech recognition."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্পিচ রিকগনিশন মডেল এখনও ডাউনলোড করা হয়নি।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تقریر کی شناخت کا ماڈل ابھی ڈاؤن لوڈ نہیں ہوا۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeli ya utambuzi wa matamshi bado haijapakuliwa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa tải xuống mô hình nhận dạng giọng nói."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مدل تشخیص گفتار هنوز بارگیری نشده است."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ดาวน์โหลดโมเดลรู้จำเสียงพูด"
          }
        }
      }
    },
    "This local engine does not support speaker identification. Turn it off or choose an external API.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This local engine does not support speaker identification. Turn it off or choose an external API."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로컬 엔진은 화자 구분을 지원하지 않습니다. 화자 구분을 끄거나 외부 API를 선택해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このローカルエンジンは話者識別に対応していません。無効にするか、外部APIを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此本地引擎不支持说话人识别。请关闭该功能或选择外部API。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此本機引擎不支援說話者識別。請關閉該功能或選擇外部API。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este motor local no identifica hablantes. Desactiva la función o elige una API externa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce moteur local n’identifie pas les locuteurs. Désactivez cette option ou choisissez une API externe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese lokale Engine unterstützt keine Sprechererkennung. Deaktivieren Sie sie oder wählen Sie eine externe API."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المحرك المحلي لا يدعم تحديد المتحدثين. عطّل الميزة أو اختر API خارجيًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्थानीय इंजन वक्ता पहचान का समर्थन नहीं करता। इसे बंद करें या बाहरी API चुनें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот локальный движок не распознаёт говорящих. Выключите эту функцию или выберите внешний API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mecanismo local não identifica falantes. Desative a função ou escolha uma API externa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este motor local não suporta a identificação de oradores. Desative-a ou escolha uma API externa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo motore locale non supporta l’identificazione degli interlocutori. Disattivala o scegli un’API esterna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten lokalny silnik nie obsługuje rozpoznawania mówców. Wyłącz tę opcję lub wybierz zewnętrzne API."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yerel motor konuşmacı tanımlamayı desteklemiyor. Bu özelliği kapatın veya harici bir API seçin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sinusuportahan ng lokal na engine na ito ang pagkilala sa nagsasalita. I-off ito o pumili ng external na API."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লোকাল ইঞ্জিন বক্তা শনাক্তকরণ সমর্থন করে না। এটি বন্ধ করুন অথবা একটি বাহ্যিক API বেছে নিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ مقامی انجن بولنے والوں کی شناخت کو سپورٹ نہیں کرتا۔ اسے آف کریں یا کوئی بیرونی API منتخب کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Injini hii ya ndani haitumii utambuzi wa wazungumzaji. Zima kipengele hicho au uchague API ya nje."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ cục bộ này không hỗ trợ nhận dạng người nói. Hãy tắt tùy chọn này hoặc chọn API bên ngoài."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این موتور محلی از تشخیص گوینده پشتیبانی نمی‌کند. آن را خاموش کنید یا یک API خارجی انتخاب کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอนจินในเครื่องนี้ไม่รองรับการระบุผู้พูด ปิดการระบุผู้พูดหรือเลือก API ภายนอก"
          }
        }
      }
    },
