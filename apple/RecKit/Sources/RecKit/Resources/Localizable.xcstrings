    "This recording has no transcription step to run.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recording has no transcription step to run."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음에는 실행할 전사 단계가 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音には文字起こしのステップがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此录音没有可运行的转录步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此錄音沒有可執行的轉錄步驟。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta grabación no tiene un paso de transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement n’a pas d’étape de transcription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufnahme hat keinen Transkriptionsschritt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد خطوة نسخ لهذا التسجيل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिकॉर्डिंग में चलाने के लिए ट्रांसक्रिप्शन चरण नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой записи нет шага расшифровки."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação não tem etapa de transcrição."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação não tem nenhum passo de transcrição a executar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa registrazione non ha un passaggio di trascrizione da eseguire."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nagranie nie ma kroku transkrypcji do wykonania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıtta çalıştırılacak bir transkripsiyon adımı yok."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang hakbang ng pag-transcribe na patatakbuhin para sa recording na ito."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রেকর্ডিংয়ে চালানোর মতো কোনো ট্রান্সক্রিপশন ধাপ নেই।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ریکارڈنگ میں چلانے کے لیے ٹرانسکرپشن کا کوئی مرحلہ نہیں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekodi hii haina hatua ya unukuzi ya kuendesha."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi âm này không có bước chép lời nào để chạy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ضبط مرحله رونویسی برای اجرا ندارد."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกเสียงนี้ไม่มีขั้นตอนการถอดเสียงให้เรียกใช้"
          }
        }
      }
    },
    "Transcription is not finished yet. The result will appear here when ready.": {
      "extractionState": "manual",
      "localizations": {
