            "state": "translated",
            "value": "Une erreur est survenue chez le fournisseur. Une nouvelle tentative suivra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Anbieter ist ein Fehler aufgetreten. Ein neuer Versuch folgt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ لدى المزوّد. ستتم إعادة المحاولة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रदाता में समस्या हुई। फिर कोशिश होगी।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У провайдера произошла ошибка. Попытка будет повторена."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro no provedor. Haverá nova tentativa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro no fornecedor. Será feita uma nova tentativa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
