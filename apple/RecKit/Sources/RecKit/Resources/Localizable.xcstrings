    "Download Apple’s speech model to transcribe on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download Apple’s speech model to transcribe on this device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 음성 모델을 다운로드하면 이 기기에서 전사할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleの音声モデルをダウンロードして、このデバイスで文字起こしを行います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载Apple语音模型即可在此设备上转录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載Apple語音模型即可在此裝置上轉錄。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga el modelo de voz de Apple para transcribir en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez le modèle vocal d’Apple pour transcrire sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie Apples Sprachmodell für Transkription auf diesem Gerät herunter."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe o modelo de voz da Apple para transcrever neste dispositivo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نزّل نموذج الكلام من Apple للنسخ على هذا الجهاز."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर ट्रांसक्रिप्शन के लिए Apple का स्पीच मॉडल डाउनलोड करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузите речевую модель Apple для расшифровки на этом устройстве."
          }
        }
      }
    }
