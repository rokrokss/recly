          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare la trascrizione. Controlla questa registrazione nell’elenco per sapere come procedere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można dokończyć transkrypcji. Sprawdź to nagranie na liście, aby zobaczyć kolejny krok."
          }
        },
        "tr": {
