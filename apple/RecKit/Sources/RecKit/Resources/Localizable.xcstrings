    "This language is not supported by the selected transcription method.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This language is not supported by the selected transcription method."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 전사 방식에서 지원하지 않는 언어입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した文字起こし方法はこの言語に対応していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选转录方式不支持此语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選轉錄方式不支援此語言。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El método de transcripción elegido no admite este idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La méthode de transcription choisie ne prend pas en charge cette langue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewählte Transkriptionsmethode unterstützt diese Sprache nicht."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طريقة النسخ المحددة لا تدعم هذه اللغة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुना गया ट्रांसक्रिप्शन तरीका यह भाषा समर्थित नहीं करता।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный способ расшифровки не поддерживает этот язык."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O método de transcrição selecionado não oferece suporte a este idioma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este idioma não é suportado pelo método de transcrição selecionado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il metodo di trascrizione selezionato non supporta questa lingua."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrana metoda transkrypcji nie obsługuje tego języka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dil, seçilen transkripsiyon yöntemi tarafından desteklenmiyor."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sinusuportahan ng napiling paraan ng pag-transcribe ang wikang ito."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেছে নেওয়া ট্রান্সক্রিপশন পদ্ধতি এই ভাষা সমর্থন করে না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کردہ ٹرانسکرپشن کا طریقہ اس زبان کو سپورٹ نہیں کرتا۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Njia ya unukuzi uliyochagua haitumii lugha hii."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phương thức chép lời đã chọn không hỗ trợ ngôn ngữ này."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روش رونویسی انتخاب‌شده از این زبان پشتیبانی نمی‌کند."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิธีถอดเสียงที่เลือกไม่รองรับภาษานี้"
          }
        }
      }
    },
