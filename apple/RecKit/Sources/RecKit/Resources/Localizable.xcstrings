    "Recorded on another device. Deleting removes it from Drive and from every device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded on another device. Deleting removes it from Drive and from every device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 녹음한 것입니다. 지우면 Drive와 모든 기기에서 사라집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスで録音されました。削除すると、Driveとすべてのデバイスから削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制于其他设备。删除后将从Drive和所有设备中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製於其他裝置。刪除後將從Drive和所有裝置中移除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabado en otro dispositivo. Al eliminarlo se borra de Drive y de todos los dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré sur un autre appareil. La suppression le retire de Drive et de tous les appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem anderen Gerät aufgenommen. Löschen entfernt die Aufnahme aus Drive und von allen Geräten."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سُجّل على جهاز آخر. يؤدي الحذف إلى إزالته من Drive وجميع الأجهزة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे डिवाइस पर रिकॉर्ड हुआ। हटाने पर Drive और सभी डिवाइस से हटेगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записано на другом устройстве. Удаление уберёт запись из Drive и со всех устройств."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravado em outro dispositivo. A exclusão remove do Drive e de todos os dispositivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravada noutro dispositivo. Eliminá-la remove-a do Drive e de todos os dispositivos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrata su un altro dispositivo. L’eliminazione la rimuove da Drive e da tutti i dispositivi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrane na innym urządzeniu. Usunięcie spowoduje usunięcie go z Drive i ze wszystkich urządzeń."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir cihazda kaydedildi. Silerseniz Drive'dan ve tüm cihazlardan kaldırılır."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-record sa ibang device. Kapag na-delete, aalisin ito sa Drive at sa bawat device."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য ডিভাইসে রেকর্ড করা হয়েছে। মুছলে এটি Drive এবং সব ডিভাইস থেকে সরে যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسرے آلے پر ریکارڈ کی گئی۔ حذف کرنے سے یہ Drive اور ہر آلے سے ہٹ جائے گی۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilirekodiwa kwenye kifaa kingine. Ukiifuta, itaondolewa kwenye Drive na kwenye kila kifaa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được ghi trên thiết bị khác. Khi xóa, bản ghi âm sẽ bị xóa khỏi Drive và mọi thiết bị."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در دستگاه دیگری ضبط شده است. حذف، آن را از Drive و همه دستگاه‌ها پاک می‌کند."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกจากอุปกรณ์อื่น การลบจะนำออกจาก Drive และจากทุกอุปกรณ์"
          }
        }
      }
    },
