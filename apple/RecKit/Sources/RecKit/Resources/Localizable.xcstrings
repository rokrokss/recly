    "This folder cannot be reached. Choose it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder cannot be reached. Choose it again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에 접근할 수 없습니다. 다시 선택하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダにアクセスできません。もう一度選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问此文件夹。请重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取此資料夾。請重新選擇。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a esta carpeta. Vuelve a elegirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est inaccessible. Choisissez-le à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesen Ordner kann nicht zugegriffen werden. Erneut auswählen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى هذا المجلد. اختره مرة أخرى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोल्डर तक नहीं पहुँचा जा सकता। इसे फिर से चुनें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к этой папке. Выберите её снова."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar esta pasta. Escolha-a novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível aceder a esta pasta. Escolha-a novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella non è raggiungibile. Sceglila di nuovo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępu do tego folderu. Wybierz go ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasöre erişilemiyor. Klasörü yeniden seçin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maabot ang folder na ito. Piliin ulit ito."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোল্ডারে পৌঁছানো যাচ্ছে না। এটি আবার বেছে নিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فولڈر تک رسائی نہیں ہو سکتی۔ اسے دوبارہ منتخب کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Folda hii haifikiki. Ichague tena."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập thư mục này. Hãy chọn lại."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به این پوشه ممکن نیست. آن را دوباره انتخاب کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าถึงโฟลเดอร์นี้ไม่ได้ เลือกอีกครั้ง"
          }
        }
      }
    },
    "The local folder cannot be reached. Choose it again in Settings.": {
