    "On-device transcription does not separate speakers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device transcription does not separate speakers."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 전사에서는 화자를 구분하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上の文字起こしは話者を区別しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备本地转录不区分说话人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置本機轉錄不區分說話者。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción en el dispositivo no separa hablantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription sur l’appareil ne distingue pas les locuteurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transkription auf dem Gerät unterscheidet keine Sprecher."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ على الجهاز لا يميّز المتحدثين."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पर ट्रांसक्रिप्शन वक्ताओं को अलग नहीं करता।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка на устройстве не разделяет говорящих."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição no dispositivo não separa falantes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição no dispositivo não separa os oradores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione sul dispositivo non distingue gli interlocutori."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja na urządzeniu nie rozróżnia mówców."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz üzerinde transkripsiyon konuşmacıları ayırmaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pinaghihiwalay ng pag-transcribe sa device ang mga nagsasalita."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইসে ট্রান্সক্রিপশন বক্তাদের আলাদা করে না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آلے پر ٹرانسکرپشن بولنے والوں کو الگ نہیں کرتا۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unukuzi kwenye kifaa hautenganishi wazungumzaji."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chép lời trên thiết bị không phân biệt người nói."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رونویسی روی دستگاه گوینده‌ها را از هم جدا نمی‌کند."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถอดเสียงในอุปกรณ์ไม่แยกผู้พูด"
          }
        }
      }
    },
