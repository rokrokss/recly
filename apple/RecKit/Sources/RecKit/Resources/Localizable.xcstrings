    "In Settings → [your name] → iCloud → Drive, turn on Sync this iPhone, then turn on Recly under Saved to iCloud → See All.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings → [your name] → iCloud → Drive, turn on Sync this iPhone, then turn on Recly under Saved to iCloud → See All."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → [이름] → iCloud → Drive에서 이 iPhone 동기화를 켜고, iCloud에 저장됨 → 모두 보기에서 Recly를 켜세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → [ユーザ名] → iCloud → Driveで「このiPhoneを同期」をオンにし、「iCloudに保存する項目」→「すべてを表示」でReclyをオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”→[你的姓名]→iCloud→“云盘”中打开“同步此iPhone”，然后在“已存至iCloud”→“查看全部”中打开Recly。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」→[你的名稱]→iCloud→「雲碟」中開啟「同步此iPhone」，然後在「儲存至iCloud」→「顯示全部」中開啟Recly。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes → [tu nombre] → iCloud → Drive, activa «Sincronizar este iPhone» y luego activa Recly en «Guardado en iCloud» → «Ver todo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages → [votre nom] → iCloud → Drive, activez « Synchroniser cet iPhone », puis activez Recly sous « Enregistré sur iCloud » → « Tout afficher »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Einstellungen → [dein Name] → iCloud → Drive „iPhone synchronisieren“ aktivieren, dann unter „Auf iCloud gesichert“ → „Alle anzeigen“ Recly aktivieren."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏في الإعدادات ← [اسمك] ← iCloud ← Drive، شغّل «مزامنة هذا الـ iPhone»، ثم شغّل Recly ضمن «المحفوظ في iCloud» ← «عرض الكل»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग → [आपका नाम] → iCloud → ड्राइव में “यह iPhone सिंक करें” चालू करें, फिर “iCloud में सहेजे गए” → “सभी देखें” में Recly चालू करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Настройки» → [ваше имя] → iCloud → Drive включите «Синхронизация этого iPhone», затем включите Recly в разделе «Сохранено в iCloud» → «Все»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Ajustes → [seu nome] → iCloud → Drive, ative “Sincronizar este iPhone” e depois ative o Recly em “Salvo no iCloud” → “Ver Tudo”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Definições → [o seu nome] → iCloud → Drive, ative Sincronizar este iPhone e depois ative o Recly em Guardado em iCloud → Ver tudo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Impostazioni → [il tuo nome] → iCloud → Drive, attiva “Sincronizza questo iPhone”, poi attiva Recly in “Salvato su iCloud” → “Mostra tutto”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Ustawieniach → [Twoje imię i nazwisko] → iCloud → Drive włącz „Synchronizuj tego iPhone’a”, a następnie włącz Recly w sekcji „Zachowano na iCloud” → „Zobacz wszystko”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar → [adınız] → iCloud → Drive'da “Bu iPhone'u Eşzamanla” seçeneğini açın, ardından “iCloud'a Kaydedilenler” → “Tümünü Gör” altında Recly'yi açın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Settings → [iyong pangalan] → iCloud → Drive, i-on ang Sync this iPhone, pagkatapos ay i-on ang Recly sa ilalim ng Saved to iCloud → See All."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংস → [আপনার নাম] → iCloud → Drive-এ “এই iPhone সিঙ্ক করুন” চালু করুন, তারপর “iCloud-এ সেভ করা” → “সব দেখুন”-এর মধ্যে Recly চালু করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتیبات ← [آپ کا نام] ← iCloud ← Drive میں “اس iPhone کی مطابقت پذیری کریں” آن کریں، پھر “iCloud میں محفوظ کردہ” ← “سبھی دیکھیں” میں Recly آن کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Katika Mipangilio → [jina lako] → iCloud → Drive, washa “Sawazisha iPhone Hii”, kisha uwashe Recly chini ya “Imehifadhiwa kwenye iCloud” → “Onyesha Zote”."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Cài đặt → [tên bạn] → iCloud → Drive, hãy bật Đồng bộ hóa iPhone này, sau đó bật Recly trong Đã lưu vào iCloud → Xem tất cả."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تنظیمات ← [نام شما] ← iCloud ← Drive، «همگام‌سازی این iPhone» را روشن کنید، سپس در «ذخیره‌شده در iCloud» ← «دیدن همه»، Recly را روشن کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการตั้งค่า → [ชื่อของคุณ] → iCloud → Drive ให้เปิด “ซิงค์ iPhone เครื่องนี้” จากนั้นเปิด Recly ใต้ “บันทึกไปยัง iCloud” → “ดูทั้งหมด”"
          }
        }
      }
    },
    "In System Settings → [your name] → iCloud → Drive, turn on Sync this Mac, then turn on Recly under Apps Syncing to iCloud Drive.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings → [your name] → iCloud → Drive, turn on Sync this Mac, then turn on Recly under Apps Syncing to iCloud Drive."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → [이름] → iCloud → Drive에서 이 Mac 동기화를 켜고, iCloud Drive에 동기화되는 앱에서 Recly를 켜세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → [ユーザ名] → iCloud → Driveで「このMacを同期」をオンにし、「iCloud Driveに同期しているアプリ」でReclyをオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”→[你的姓名]→iCloud→“云盘”中打开“同步此Mac”，然后在“同步至iCloud云盘的App”中打开Recly。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定」→[你的名稱]→iCloud→「雲碟」中開啟「同步此Mac」，然後在「同步到『iCloud雲碟』的App」中開啟Recly。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes del Sistema → [tu nombre] → iCloud → Drive, activa «Sincronizar este Mac» y luego activa Recly en «Apps sincronizadas con iCloud Drive»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages Système → [votre nom] → iCloud → Drive, activez « Synchroniser ce Mac », puis activez Recly sous « Apps se synchronisant avec iCloud Drive »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Systemeinstellungen → [dein Name] → iCloud → Drive „Diesen Mac synchronisieren“ aktivieren, dann unter „Apps, die über iCloud Drive synchronisiert werden“ Recly aktivieren."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏في إعدادات النظام ← [اسمك] ← iCloud ← Drive، شغّل «مزامنة هذا الـ Mac»، ثم شغّل Recly ضمن «التطبيقات التي تتم مزامنتها مع iCloud Drive»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग → [आपका नाम] → iCloud → ड्राइव में “यह Mac सिंक करें” चालू करें, फिर “iCloud Drive पर सिंक हो रहे ऐप्स” में Recly चालू करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Системные настройки» → [ваше имя] → iCloud → Drive включите «Синхронизация этого Mac», затем включите Recly в разделе «Приложения, которые синхронизируются с iCloud Drive»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Ajustes do Sistema → [seu nome] → iCloud → Drive, ative “Sincronizar este Mac” e depois ative o Recly em “Sincronização de Apps com o iCloud Drive”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Definições do Sistema → [o seu nome] → iCloud → Drive, ative Sincronizar este Mac e depois ative o Recly em Apps a sincronizar com o iCloud Drive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Impostazioni di Sistema → [il tuo nome] → iCloud → Drive, attiva “Sincronizza questo Mac”, poi attiva Recly in “App che si sincronizzano con iCloud Drive”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Ustawieniach systemowych → [Twoje imię i nazwisko] → iCloud → Drive włącz „Synchronizuj tego Maca”, a następnie włącz Recly w sekcji „Aplikacje synchronizowane z iCloud Drive”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → [adınız] → iCloud → Drive'da “Bu Mac'i Eşzamanla” seçeneğini açın, ardından “iCloud Drive ile Eşzamanlanan Uygulamalar” altında Recly'yi açın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa System Settings → [iyong pangalan] → iCloud → Drive, i-on ang Sync this Mac, pagkatapos ay i-on ang Recly sa ilalim ng Apps Syncing to iCloud Drive."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংস → [আপনার নাম] → iCloud → Drive-এ “এই Mac সিঙ্ক করুন” চালু করুন, তারপর “iCloud Drive-এ সিঙ্ক হওয়া অ্যাপ”-এর মধ্যে Recly চালু করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم ترتیبات ← [آپ کا نام] ← iCloud ← Drive میں “اس Mac کی مطابقت پذیری کریں” آن کریں، پھر “iCloud Drive سے مطابقت پذیر ایپس” میں Recly آن کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Katika Mipangilio ya Mfumo → [jina lako] → iCloud → Drive, washa “Sawazisha Mac Hii”, kisha uwashe Recly chini ya “Programu Zinazosawazisha na iCloud Drive”."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Cài đặt hệ thống → [tên bạn] → iCloud → Drive, hãy bật Đồng bộ hóa máy Mac này, sau đó bật Recly trong Ứng dụng đồng bộ hóa với iCloud Drive."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تنظیمات سیستم ← [نام شما] ← iCloud ← Drive، «همگام‌سازی این Mac» را روشن کنید، سپس در «برنامه‌های همگام‌سازی با iCloud Drive»، Recly را روشن کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการตั้งค่าระบบ → [ชื่อของคุณ] → iCloud → Drive ให้เปิด “ซิงค์ Mac เครื่องนี้” จากนั้นเปิด Recly ใต้ “แอปที่ซิงค์กับ iCloud Drive”"
          }
        }
      }
    },
