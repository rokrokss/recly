    "This transcription provider is unavailable in your App Store region.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This transcription provider is unavailable in your App Store region."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 전사 제공업체는 현재 App Store 지역에서 사용할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文字起こし提供者は、お使いのApp Storeの地域では利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此转录提供商在您的App Store地区不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此轉錄供應商在您的App Store地區無法使用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proveedor no está disponible en tu región de App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur est indisponible dans votre région App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Transkriptionsanbieter ist in Ihrer App-Store-Region nicht verfügbar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزوّد النسخ هذا غير متاح في منطقة App Store لديك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ट्रांसक्रिप्शन प्रदाता आपके App Store क्षेत्र में उपलब्ध नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот провайдер расшифровки недоступен в вашем регионе App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este provedor não está disponível na sua região da App Store."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este fornecedor de transcrição não está disponível na sua região da App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo fornitore di trascrizione non è disponibile nella tua regione dell’App Store."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten dostawca transkrypcji jest niedostępny w Twoim regionie App Store."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu transkripsiyon sağlayıcısı App Store bölgenizde kullanılamaz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi available ang provider ng pag-transcribe na ito sa iyong rehiyon ng App Store."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ট্রান্সক্রিপশন প্রদানকারী আপনার App Store অঞ্চলে উপলভ্য নয়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ٹرانسکرپشن فراہم کنندہ آپ کے App Store علاقے میں دستیاب نہیں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtoa huduma huyu wa unukuzi hapatikani katika eneo lako la App Store."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp dịch vụ chép lời này không khả dụng ở khu vực App Store của bạn."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ارائه‌دهنده رونویسی در منطقه App Store شما در دسترس نیست."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการถอดเสียงนี้ใช้ไม่ได้ในภูมิภาค App Store ของคุณ"
          }
        }
      }
    },
