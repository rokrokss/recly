            "value": "소문자로 시작하고 소문자·숫자·밑줄 32자까지"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英小文字で始め、英小文字・数字・アンダースコアを32文字以内で入力"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以小写字母开头，仅含小写字母、数字和下划线，最多32个字符"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以小寫字母開頭，僅含小寫字母、數字和底線，最多32個字元"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza por una minúscula; minúsculas, números y guiones bajos, hasta 32 caracteres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence par une minuscule ; minuscules, chiffres et tirets bas, 32 caractères maximum"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnt mit Kleinbuchstaben; Kleinbuchstaben, Ziffern und Unterstriche, höchstens 32 Zeichen"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa com minúscula; minúsculas, números e sublinhados, até 32 caracteres"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ بحرف صغير؛ أحرف صغيرة وأرقام وشرطة سفلية، حتى 32 حرفًا"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटे अक्षर से शुरू; छोटे अक्षर, अंक और अंडरस्कोर, अधिकतम 32"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинается со строчной буквы; строчные буквы, цифры и подчёркивания, до 32 символов"
          }
        }
      }
    },
