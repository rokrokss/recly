      }
    },
    "Google access was revoked, but %@ recording(s) were still running and were kept — disconnect again once they have finished.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google access was revoked, but %@ recording(s) were still running and were kept — disconnect again once they have finished."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 액세스는 해제했지만 실행 중이던 녹음 %@건은 남겨 두었습니다 — 작업이 끝난 뒤 연결 해제를 다시 실행하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleのアクセス権は取り消しましたが、処理中の録音%@件は残しています。完了後にもう一度接続を解除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤销Google访问权限，但仍保留%@条正在处理的录音。请在处理完成后再次断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤銷Google存取權限，但仍保留%@筆正在處理的錄音。請在處理完成後再次中斷連線。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se revocó el acceso a Google, pero se conservaron %@ grabaciones en curso. Vuelve a desconectar cuando terminen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès Google a été révoqué, mais %@ enregistrements en cours ont été conservés. Déconnectez à nouveau après leur fin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google-Zugriff wurde widerrufen. Noch laufende Aufnahmen wurden behalten: %@. Trennen Sie nach deren Abschluss erneut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso Google foi revogado, mas %@ gravações em andamento foram mantidas. Desconecte novamente quando terminarem."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي وصول Google، لكن التسجيلات التي كانت قيد المعالجة حُفظت وعددها %@. افصل مجددًا بعد انتهائها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google एक्सेस रद्द हुआ, लेकिन चल रही %@ रिकॉर्डिंग रखी गईं। उनके पूरा होने पर फिर डिस्कनेक्ट करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ Google отозван, но сохранено незавершённых записей: %@. Отключитесь снова после их завершения."
          }
        }
      }
    },
    "Google access was revoked, but cleaning up this device failed: %@ — try Disconnect again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not disconnect Drive. Try again in Settings. (%@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive 연결 해제에 실패했습니다. 설정에서 다시 시도하세요. (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Driveの接続を解除できませんでした。設定で再試行してください。（%@）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
