          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إكمال النسخ. راجع التسجيل في القائمة لمعرفة الخطوة التالية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्शन पूरा नहीं हुआ। अगले कदम के लिए सूची में यह रिकॉर्डिंग देखें।"
          }
