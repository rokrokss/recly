    "Could not check the Google sign-in — try Disconnect again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not check the Google connection. Try disconnecting Drive again in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 연결 상태를 확인하지 못했습니다. 설정에서 Drive 연결 해제를 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleとの接続を確認できませんでした。設定でDriveの接続解除を再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查Google连接。请在设置中重试断开Drive。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查Google連線。請在設定中重試中斷Drive連線。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo comprobar la conexión con Google. Intenta desconectar Drive otra vez en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier la connexion Google. Réessayez de déconnecter Drive dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Google-Verbindung konnte nicht geprüft werden. Trennen Sie Drive erneut in den Einstellungen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من اتصال Google. حاول فصل Drive مجددًا من الإعدادات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google कनेक्शन जाँचा नहीं जा सका। सेटिंग में Drive को फिर डिस्कनेक्ट करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить подключение Google. Попробуйте снова отключить Drive в настройках."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a conexão Google. Tente desconectar o Drive novamente em Configurações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a ligação ao Google. Tente desligar o Drive novamente nas Definições."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare il collegamento a Google. Prova di nuovo a scollegare Drive in Impostazioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można sprawdzić połączenia z Google. Spróbuj ponownie odłączyć Drive w Ustawieniach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google bağlantısı kontrol edilemedi. Ayarlar'da Drive bağlantısını yeniden kesmeyi deneyin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi masuri ang koneksyon sa Google. Subukang idiskonekta ulit ang Drive sa Mga Setting."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Google কানেকশন যাচাই করা যায়নি। সেটিংসে আবার Drive ডিসকানেক্ট করার চেষ্টা করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Google کنکشن چیک نہیں کیا جا سکا۔ ترتیبات میں Drive کو دوبارہ منقطع کرنے کی کوشش کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kukagua muunganisho wa Google. Jaribu tena kutenganisha Drive katika Mipangilio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kiểm tra kết nối Google. Hãy thử ngắt kết nối Drive lại trong Cài đặt."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال Google بررسی نشد. قطع اتصال Drive را دوباره در تنظیمات امتحان کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบการเชื่อมต่อ Google ไม่ได้ ลองยกเลิกการเชื่อมต่อ Drive อีกครั้งในการตั้งค่า"
          }
        }
      }
    },
