          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo desconectar Drive. Inténtalo en Ajustes. (%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déconnecter Drive. Réessayez dans Réglages. (%@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive konnte nicht getrennt werden. Versuchen Sie es in den Einstellungen erneut. (%@)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desconectar o Drive. Tente novamente em Configurações. (%@)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فصل Drive. أعد المحاولة من الإعدادات. (%@)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive डिस्कनेक्ट नहीं हो सका। सेटिंग में फिर कोशिश करें। (%@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отключить Drive. Повторите попытку в настройках. (%@)"
          }
        }
      }
    },
