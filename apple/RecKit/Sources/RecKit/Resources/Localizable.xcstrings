          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier local est inaccessible. Choisissez-le à nouveau dans les Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den lokalen Ordner kann nicht zugegriffen werden. In den Einstellungen erneut auswählen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى المجلد المحلي. اختره مرة أخرى في الإعدادات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकल फ़ोल्डर तक नहीं पहुँचा जा सकता। सेटिंग में इसे फिर से चुनें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к локальной папке. Выберите её снова в Настройках."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar a pasta local. Escolha-a novamente em Configurações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível aceder à pasta local. Escolha-a novamente nas Definições."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella locale non è raggiungibile. Sceglila di nuovo in Impostazioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępu do folderu lokalnego. Wybierz go ponownie w Ustawieniach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel klasöre erişilemiyor. Ayarlar'da klasörü yeniden seçin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maabot ang lokal na folder. Piliin ulit ito sa Mga Setting."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লোকাল ফোল্ডারে পৌঁছানো যাচ্ছে না। সেটিংসে এটি আবার বেছে নিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی فولڈر تک رسائی نہیں ہو سکتی۔ ترتیبات میں اسے دوبارہ منتخب کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Folda ya ndani haifikiki. Ichague tena katika Mipangilio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập thư mục cục bộ. Hãy chọn lại trong Cài đặt."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به پوشه محلی ممکن نیست. آن را دوباره در تنظیمات انتخاب کنید."
