        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive অ্যাক্সেসের জন্য আপনার সম্মতি প্রয়োজন"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive تک رسائی کے لیے آپ کی رضامندی درکار ہے"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufikiaji wa Drive unahitaji ridhaa yako"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truy cập Drive cần sự đồng ý của bạn"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به Drive به رضایت شما نیاز دارد"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึง Drive ต้องได้รับความยินยอมจากคุณ"
          }
        }
      }
    },
    "Every device signed in with this account loses access, not only this one. To leave just this Mac, sign out instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other devices using this Google authorization may also lose access."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 Google 승인을 사용하는 다른 기기도 접근 권한을 잃을 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このGoogle認証を使う他のデバイスもアクセスできなくなる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此Google授权的其他设备也可能失去访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此Google授權的其他裝置也可能失去存取權限。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros dispositivos que usan esta autorización de Google también podrían perder el acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres appareils utilisant cette autorisation Google peuvent aussi perdre l’accès."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Geräte mit dieser Google-Autorisierung können ebenfalls den Zugriff verlieren."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تفقد الأجهزة الأخرى التي تستخدم تفويض Google هذا إمكانية الوصول أيضًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Google अनुमति का उपयोग करने वाले अन्य डिवाइस का एक्सेस भी हट सकता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие устройства с этой авторизацией Google тоже могут потерять доступ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outros dispositivos que usam esta autorização Google também podem perder o acesso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outros dispositivos que utilizam esta autorização Google também podem perder o acesso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche altri dispositivi che usano questa autorizzazione Google potrebbero perdere l’accesso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne urządzenia korzystające z tej autoryzacji Google również mogą stracić dostęp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Google yetkilendirmesini kullanan diğer cihazlar da erişimi kaybedebilir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaari ding mawalan ng access ang ibang device na gumagamit ng awtorisasyong ito sa Google."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Google অনুমোদন ব্যবহার করা অন্য ডিভাইসগুলোও অ্যাক্সেস হারাতে পারে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Google اجازت کو استعمال کرنے والے دیگر آلات کی رسائی بھی ختم ہو سکتی ہے۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vifaa vingine vinavyotumia uidhinishaji huu wa Google vinaweza pia kupoteza ufikiaji."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thiết bị khác dùng quyền cấp phép Google này cũng có thể mất quyền truy cập."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است دسترسی دستگاه‌های دیگری که از این مجوز Google استفاده می‌کنند نیز قطع شود."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์อื่นที่ใช้การให้สิทธิ์ Google นี้อาจสูญเสียการเข้าถึงด้วย"
          }
        }
      }
    },
