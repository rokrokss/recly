        }
      }
    },
    "Google Drive is out of space — free some up and try again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive is out of space — free some up and try again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive에 공간이 없습니다 — 정리한 뒤 다시 시도하세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Driveの容量が不足しています。空きを作って再試行してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive空间不足，请释放空间后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive空間不足，請釋出空間後重試"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive no tiene espacio. Libera espacio y vuelve a intentarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive est plein. Libérez de l’espace et réessayez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive ist voll. Speicherplatz freigeben und erneut versuchen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة Google Drive ممتلئة. أفرغ بعض المساحة وأعد المحاولة"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive में जगह नहीं है। जगह खाली करके फिर कोशिश करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Google Drive закончилось место. Освободите его и повторите попытку"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Google Drive está sem espaço. Libere espaço e tente novamente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Google Drive está sem espaço — liberte espaço e tente novamente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio esaurito su Google Drive: liberane un po’ e riprova"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak miejsca na Google Drive — zwolnij trochę miejsca i spróbuj ponownie"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive'da yer kalmadı — biraz yer açıp yeniden deneyin"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puno na ang Google Drive — magbakante ng espasyo at subukang muli"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive-এ জায়গা নেই; কিছু জায়গা খালি করে আবার চেষ্টা করুন"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive میں جگہ ختم ہو گئی ہے — کچھ جگہ خالی کریں اور دوبارہ کوشش کریں"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive imejaa — futa vitu ili kupata nafasi kisha ujaribu tena"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive đã hết dung lượng — hãy giải phóng bớt rồi thử lại"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فضای Google Drive پر است؛ مقداری فضا آزاد کنید و دوباره امتحان کنید"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ Google Drive เต็ม เพิ่มพื้นที่ว่างแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Google access was revoked. Recordings still running and kept: %@ — disconnect again once they have finished.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google access was revoked. Recordings still running and kept: %@ — disconnect again once they have finished."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 액세스는 해제했지만 실행 중이던 녹음 %@건은 남겨 두었습니다 — 작업이 끝난 뒤 연결 해제를 다시 실행하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleのアクセス権は取り消しましたが、処理中の録音%@件は残しています。完了後にもう一度接続を解除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤销Google访问权限，但仍保留%@条正在处理的录音。请在处理完成后再次断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤銷Google存取權限，但仍保留%@筆正在處理的錄音。請在處理完成後再次中斷連線。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se revocó el acceso a Google, pero se conservaron %@ grabaciones en curso. Vuelve a desconectar cuando terminen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès Google a été révoqué, mais %@ enregistrements en cours ont été conservés. Déconnectez à nouveau après leur fin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google-Zugriff wurde widerrufen. Noch laufende Aufnahmen wurden behalten: %@. Trennen Sie nach deren Abschluss erneut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي وصول Google، لكن التسجيلات التي كانت قيد المعالجة حُفظت وعددها %@. افصل مجددًا بعد انتهائها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google एक्सेस रद्द हुआ, लेकिन चल रही %@ रिकॉर्डिंग रखी गईं। उनके पूरा होने पर फिर डिस्कनेक्ट करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ Google отозван, но сохранено незавершённых записей: %@. Отключитесь снова после их завершения."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso Google foi revogado, mas %@ gravações em andamento foram mantidas. Desconecte novamente quando terminarem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao Google foi revogado. Gravações ainda em curso e mantidas: %@ — desligue novamente quando terminarem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso Google revocato. Registrazioni ancora in corso e conservate: %@. Scollega di nuovo quando saranno terminate."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp Google został cofnięty. Zachowane nagrania w toku: %@ — odłącz ponownie, gdy się zakończą."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google erişimi iptal edildi. Hâlâ devam eden ve korunan kayıtlar: %@ — bunlar bittiğinde bağlantıyı yeniden kesin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binawi ang access sa Google. Mga recording na tumatakbo pa at pinanatili: %@ — idiskonekta ulit kapag tapos na ang mga ito."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Google অ্যাক্সেস প্রত্যাহার করা হয়েছে। এখনও চলমান ও রেখে দেওয়া রেকর্ডিং: %@; সেগুলো শেষ হলে আবার ডিসকানেক্ট করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Google رسائی منسوخ کر دی گئی۔ ابھی جاری اور محفوظ رکھی گئی ریکارڈنگز: %@ — ان کے مکمل ہونے پر دوبارہ منقطع کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufikiaji wa Google umebatilishwa. Rekodi ambazo bado zinaendelea na zimebakizwa: %@ — tenganisha tena zikishakamilika."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thu hồi quyền truy cập Google. Vẫn giữ lại %@ bản ghi âm đang xử lý — hãy ngắt kết nối lại khi chúng hoàn tất."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی Google لغو شد. ضبط‌هایی که هنوز در حال پردازش هستند و نگه داشته شدند: %@؛ پس از پایان آن‌ها دوباره اتصال را قطع کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิกถอนการเข้าถึงของ Google แล้ว การบันทึกเสียงที่ยังดำเนินการอยู่และเก็บไว้: %@ ยกเลิกการเชื่อมต่ออีกครั้งเมื่อดำเนินการเสร็จแล้ว"
          }
        }
      }
    },
    "Google access was revoked, but cleaning up this device failed: %@ — try Disconnect again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not disconnect Drive. Try again in Settings. (%@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive 연결 해제에 실패했습니다. 설정에서 다시 시도하세요. (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Driveの接続を解除できませんでした。設定で再試行してください。（%@）"
          }
        },
        "zh-Hans": {
