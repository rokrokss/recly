    "Permission covers future recordings on this device. You can withdraw it in Settings → Privacy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission covers future recordings on this device. You can withdraw it in Settings → Privacy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 이 기기의 이후 녹음에도 적용됩니다. 설정 → 개인정보 보호에서 철회할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この許可は、このデバイスで今後行う録音にも適用されます。「設定→プライバシー」で取り消せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此权限适用于此设备上的后续录音，可在“设置→隐私”中撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此權限適用於此裝置上的後續錄音，可在「設定→隱私權」中撤銷。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso cubre futuras grabaciones en este dispositivo. Puedes retirarlo en Ajustes → Privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation couvre les futurs enregistrements sur cet appareil. Retirez-la dans Réglages → Confidentialité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung gilt für zukünftige Aufnahmen auf diesem Gerät. Unter Einstellungen → Datenschutz widerrufbar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão abrange futuras gravações neste dispositivo. Revogue em Configurações → Privacidade."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل الإذن التسجيلات المستقبلية على هذا الجهاز. يمكنك سحبه من الإعدادات ← الخصوصية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति इस डिवाइस की आगे की रिकॉर्डिंग पर भी लागू है। इसे सेटिंग → गोपनीयता में वापस ले सकते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение действует и на будущие записи на этом устройстве. Его можно отозвать в Настройки → Конфиденциальность."
          }
        }
      }
    },
    "Permission is needed before sending to this destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission is needed before sending to this destination"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
