    "For a custom endpoint, also check its operator’s privacy policy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a custom endpoint, also check its operator’s privacy policy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 주소라면 해당 운영자의 개인정보 처리방침도 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自のエンドポイントを使う場合は、運営者のプライバシーポリシーも確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自定义端点时，请同时查看其运营方的隐私政策。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自訂端點時，請同時查看其營運方的隱私權政策。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si usas un endpoint personalizado, consulta también la política de privacidad de su operador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un point de terminaison personnalisé, consultez aussi la politique de confidentialité de son opérateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie bei einem eigenen Endpunkt auch die Datenschutzerklärung seines Betreibers."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para um endpoint personalizado, consulte também a política de privacidade do operador."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند استخدام نقطة اتصال مخصصة، راجع أيضًا سياسة خصوصية مشغّلها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कस्टम एंडपॉइंट के लिए उसके संचालक की गोपनीयता नीति भी जाँचें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для собственного адреса API также ознакомьтесь с политикой конфиденциальности его оператора."
          }
        }
      }
    },
