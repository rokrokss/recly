    "The upload queue on this Mac is wiped. Workflows and keys stay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending processing pauses until you reconnect the same account. Recordings, Drive files and keys stay."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 처리는 같은 계정에 다시 연결하면 이어집니다. 녹음, Drive 파일과 키는 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じアカウントに再接続するまで処理を一時停止します。録音、Driveのファイル、キーは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新连接同一账号前，待处理任务将暂停。录音、Drive文件和密钥都会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新連接同一帳戶前，待處理工作將暫停。錄音、Drive檔案和金鑰都會保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesamiento pendiente se pausa hasta reconectar la misma cuenta. Se conservan grabaciones, archivos de Drive y claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traitement en attente est suspendu jusqu’à la reconnexion du même compte. Enregistrements, fichiers Drive et clés sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausstehende Verarbeitung pausiert, bis dasselbe Konto erneut verbunden ist. Aufnahmen, Drive-Dateien und Schlüssel bleiben erhalten."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف المعالجة المعلّقة حتى إعادة ربط الحساب نفسه. تبقى التسجيلات وملفات Drive والمفاتيح."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वही खाता फिर कनेक्ट होने तक लंबित प्रोसेसिंग रुकेगी। रिकॉर्डिंग, Drive फ़ाइलें और कुंजियाँ बनी रहेंगी।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработка приостановится до повторного подключения того же аккаунта. Записи, файлы Drive и ключи сохранятся."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O processamento pendente pausa até reconectar a mesma conta. Gravações, arquivos do Drive e chaves são mantidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O processamento pendente fica em pausa até voltar a ligar a mesma conta. As gravações, os ficheiros do Drive e as chaves são mantidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elaborazione in sospeso si interrompe finché non ricolleghi lo stesso account. Registrazioni, file di Drive e chiavi restano."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekujące przetwarzanie zostanie wstrzymane do ponownego połączenia tego samego konta. Nagrania, pliki na Drive i klucze zostaną zachowane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen işlemler, aynı hesabı yeniden bağlayana kadar duraklatılır. Kayıtlar, Drive dosyaları ve anahtarlar korunur."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-pause ang nakabinbing pagproseso hanggang ikonekta mo ulit ang parehong account. Mananatili ang mga recording, file sa Drive, at key."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একই অ্যাকাউন্ট আবার কানেক্ট না করা পর্যন্ত বাকি প্রসেসিং থেমে থাকবে। রেকর্ডিং, Drive ফাইল এবং কী-গুলো থেকে যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک آپ وہی اکاؤنٹ دوبارہ منسلک نہ کریں، زیر التواء پروسیسنگ رکی رہے گی۔ ریکارڈنگز، Drive فائلیں اور کلیدیں برقرار رہیں گی۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchakataji unaosubiri utasitishwa hadi uunganishe tena akaunti ile ile. Rekodi, faili za Drive na funguo zitabaki."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc xử lý đang chờ sẽ tạm dừng cho đến khi bạn kết nối lại cùng tài khoản. Bản ghi âm, tệp Drive và khóa vẫn được giữ."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پردازش‌های در انتظار تا اتصال دوباره همان حساب متوقف می‌مانند. ضبط‌ها، فایل‌های Drive و کلیدها باقی می‌مانند."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การประมวลผลที่รออยู่จะหยุดชั่วคราวจนกว่าคุณจะเชื่อมต่อบัญชีเดิมอีกครั้ง การบันทึกเสียง ไฟล์ใน Drive และคีย์จะยังคงอยู่"
          }
        }
      }
    },
    "The upload queue on this phone is wiped. Workflows and keys stay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending processing pauses until you reconnect the same account. Recordings, Drive files and keys stay."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 처리는 같은 계정에 다시 연결하면 이어집니다. 녹음, Drive 파일과 키는 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じアカウントに再接続するまで処理を一時停止します。録音、Driveのファイル、キーは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新连接同一账号前，待处理任务将暂停。录音、Drive文件和密钥都会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新連接同一帳戶前，待處理工作將暫停。錄音、Drive檔案和金鑰都會保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesamiento pendiente se pausa hasta reconectar la misma cuenta. Se conservan grabaciones, archivos de Drive y claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traitement en attente est suspendu jusqu’à la reconnexion du même compte. Enregistrements, fichiers Drive et clés sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausstehende Verarbeitung pausiert, bis dasselbe Konto erneut verbunden ist. Aufnahmen, Drive-Dateien und Schlüssel bleiben erhalten."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف المعالجة المعلّقة حتى إعادة ربط الحساب نفسه. تبقى التسجيلات وملفات Drive والمفاتيح."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वही खाता फिर कनेक्ट होने तक लंबित प्रोसेसिंग रुकेगी। रिकॉर्डिंग, Drive फ़ाइलें और कुंजियाँ बनी रहेंगी।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработка приостановится до повторного подключения того же аккаунта. Записи, файлы Drive и ключи сохранятся."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O processamento pendente pausa até reconectar a mesma conta. Gravações, arquivos do Drive e chaves são mantidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O processamento pendente fica em pausa até voltar a ligar a mesma conta. As gravações, os ficheiros do Drive e as chaves são mantidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elaborazione in sospeso si interrompe finché non ricolleghi lo stesso account. Registrazioni, file di Drive e chiavi restano."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekujące przetwarzanie zostanie wstrzymane do ponownego połączenia tego samego konta. Nagrania, pliki na Drive i klucze zostaną zachowane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen işlemler, aynı hesabı yeniden bağlayana kadar duraklatılır. Kayıtlar, Drive dosyaları ve anahtarlar korunur."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-pause ang nakabinbing pagproseso hanggang ikonekta mo ulit ang parehong account. Mananatili ang mga recording, file sa Drive, at key."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একই অ্যাকাউন্ট আবার কানেক্ট না করা পর্যন্ত বাকি প্রসেসিং থেমে থাকবে। রেকর্ডিং, Drive ফাইল এবং কী-গুলো থেকে যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک آپ وہی اکاؤنٹ دوبارہ منسلک نہ کریں، زیر التواء پروسیسنگ رکی رہے گی۔ ریکارڈنگز، Drive فائلیں اور کلیدیں برقرار رہیں گی۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchakataji unaosubiri utasitishwa hadi uunganishe tena akaunti ile ile. Rekodi, faili za Drive na funguo zitabaki."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc xử lý đang chờ sẽ tạm dừng cho đến khi bạn kết nối lại cùng tài khoản. Bản ghi âm, tệp Drive và khóa vẫn được giữ."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پردازش‌های در انتظار تا اتصال دوباره همان حساب متوقف می‌مانند. ضبط‌ها، فایل‌های Drive و کلیدها باقی می‌مانند."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การประมวลผลที่รออยู่จะหยุดชั่วคราวจนกว่าคุณจะเชื่อมต่อบัญชีเดิมอีกครั้ง การบันทึกเสียง ไฟล์ใน Drive และคีย์จะยังคงอยู่"
          }
        }
      }
    },
