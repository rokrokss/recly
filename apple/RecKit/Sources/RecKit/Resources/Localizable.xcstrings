    "On-device transcription needs Apple’s speech recognition model.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device transcription needs Apple’s speech recognition model."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 전사에는 Apple 음성 인식 모델이 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上の文字起こしには、Appleの音声認識モデルが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备本地转录需要 Apple 的语音识别模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置本機轉錄需要 Apple 的語音辨識模型。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción en el dispositivo necesita el modelo de reconocimiento de voz de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription sur l’appareil nécessite le modèle de reconnaissance vocale d’Apple."
          }
