    "Withdrawing permission stops future requests. It does not delete data already sent or your saved API keys.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdrawing permission stops future requests. It does not delete data already sent or your saved API keys."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용을 철회하면 이후 요청을 중단합니다. 이미 전송한 데이터나 저장된 API 키는 삭제되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可を取り消すと今後のリクエストが停止します。送信済みのデータや保存済みのAPIキーは削除されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销权限将停止后续请求，不会删除已发送的数据或保存的API密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷權限將停止後續請求，不會刪除已傳送的資料或儲存的API金鑰。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirar el permiso detiene futuras solicitudes. No elimina los datos ya enviados ni las claves API guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retrait bloque les futures requêtes. Les données déjà envoyées et les clés API enregistrées ne sont pas supprimées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Widerruf stoppt zukünftige Anfragen. Bereits gesendete Daten und gespeicherte API-Schlüssel werden nicht gelöscht."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سحب الإذن يوقف الطلبات المستقبلية. لا يحذف البيانات المُرسلة أو مفاتيح API المحفوظة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति वापस लेने पर आगे के अनुरोध रुकेंगे। पहले भेजा डेटा या सहेजी API कुंजियाँ नहीं हटेंगी।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отзыв разрешения останавливает будущие запросы. Уже отправленные данные и сохранённые ключи API не удаляются."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revogar a permissão interrompe solicitações futuras. Não exclui dados já enviados nem chaves de API salvas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirar a permissão impede pedidos futuros. Não elimina os dados já enviados nem as chaves de API guardadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La revoca dell’autorizzazione blocca le richieste future. Non elimina i dati già inviati né le chiavi API salvate."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycofanie zgody zatrzymuje przyszłe żądania. Nie usuwa już wysłanych danych ani zapisanych kluczy API."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzni geri çekmek sonraki istekleri durdurur. Daha önce gönderilmiş verileri veya kaydettiğiniz API anahtarlarını silmez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag binawi ang pahintulot, hihinto ang mga susunod na request. Hindi nito dine-delete ang data na naipadala na o ang iyong mga naka-save na API key."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমতি প্রত্যাহার করলে ভবিষ্যতের অনুরোধ বন্ধ হয়ে যায়। এতে আগে পাঠানো ডেটা বা আপনার সেভ করা API কী মুছে যায় না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازت واپس لینے سے آئندہ درخواستیں رک جاتی ہیں۔ اس سے پہلے سے بھیجا گیا ڈیٹا یا آپ کی محفوظ API کلیدیں حذف نہیں ہوتیں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kubatilisha ruhusa husimamisha maombi yajayo. Hakufuti data iliyokwisha kutumwa wala funguo zako za API zilizohifadhiwa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rút lại quyền sẽ dừng các yêu cầu sau này. Thao tác này không xóa dữ liệu đã gửi hoặc các khóa API bạn đã lưu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس گرفتن اجازه، درخواست‌های آینده را متوقف می‌کند. داده‌هایی که قبلاً ارسال شده‌اند یا کلیدهای API ذخیره‌شده شما را حذف نمی‌کند."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถอนการอนุญาตจะหยุดคำขอในอนาคต แต่จะไม่ลบข้อมูลที่ส่งไปแล้วหรือคีย์ API ที่บันทึกไว้"
          }
        }
      }
    },
