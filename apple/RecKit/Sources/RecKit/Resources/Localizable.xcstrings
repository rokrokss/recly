    "Review the folder and transcription method before saving. Keys are not included.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the folder and transcription method before saving. Keys are not included."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하기 전에 폴더와 전사 방식을 확인하세요. 키 값은 포함되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存前にフォルダと文字起こし方法を確認してください。キーは含まれていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存前请检查文件夹和转录方式。不包含密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存前請檢查資料夾和轉錄方式。不包含金鑰。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la carpeta y el método de transcripción antes de guardar. No se incluyen claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le dossier et la méthode de transcription avant d’enregistrer. Les clés sont exclues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie Ordner und Transkriptionsmethode vor dem Speichern. Schlüssel sind nicht enthalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise a pasta e o método de transcrição antes de salvar. As chaves não estão incluídas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع المجلد وطريقة النسخ قبل الحفظ. المفاتيح غير مُضمّنة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजने से पहले फ़ोल्डर और ट्रांसक्रिप्शन तरीका जाँचें। कुंजियाँ शामिल नहीं हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте папку и способ расшифровки перед сохранением. Ключи не включены."
          }
        }
      }
    },
    "These settings cannot be read by this version. The original data has been preserved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These settings cannot be read by this version. The original data has been preserved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전에서 설정을 읽을 수 없습니다. 원본 데이터는 보존되었습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンでは設定を読み込めません。元のデータは保持されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本无法读取这些设置，原始数据已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本無法讀取這些設定，原始資料已保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no puede leer estos ajustes. Los datos originales se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version ne peut pas lire ces réglages. Les données d’origine sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version kann die Einstellungen nicht lesen. Die ursprünglichen Daten bleiben erhalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão não pode ler estas configurações. Os dados originais foram preservados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع هذا الإصدار قراءة هذه الإعدادات. تم الاحتفاظ بالبيانات الأصلية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह संस्करण इन सेटिंग को नहीं पढ़ सकता। मूल डेटा सुरक्षित है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия не может прочитать настройки. Исходные данные сохранены."
          }
        }
      }
    },
