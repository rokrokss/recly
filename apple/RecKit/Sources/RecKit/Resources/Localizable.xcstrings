    "Recly loses Drive access on all devices connected to this Google account. Pending work pauses until you reconnect the same account. Recordings and settings stay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly loses Drive access on all devices connected to this Google account. Pending work pauses until you reconnect the same account. Recordings and settings stay."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 Google 계정으로 연결한 모든 기기에서 Recly의 Drive 접근 권한을 해제합니다. 대기 작업은 같은 계정에 다시 연결하면 이어집니다. 녹음과 설정은 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このGoogleアカウントに接続したすべてのデバイスで、ReclyはDriveにアクセスできなくなります。同じアカウントに再接続するまで処理は一時停止します。録音と設定は残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接此Google账号的所有设备上的Recly都将失去Drive访问权限。重新连接同一账号前，待处理任务将暂停。录音和设置会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接此Google帳戶的所有裝置上的Recly都將失去Drive存取權限。重新連接同一帳戶前，待處理工作將暫停。錄音和設定會保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly pierde el acceso a Drive en todos los dispositivos conectados a esta cuenta Google. El trabajo pendiente se pausa hasta reconectar la misma cuenta. Se conservan grabaciones y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly perd l’accès à Drive sur tous les appareils liés à ce compte Google. Le travail en attente est suspendu jusqu’à la reconnexion du même compte. Enregistrements et réglages sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly verliert den Drive-Zugriff auf allen mit diesem Google-Konto verbundenen Geräten. Ausstehende Aufgaben pausieren bis zur erneuten Verbindung desselben Kontos. Aufnahmen und Einstellungen bleiben erhalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Recly perde o acesso ao Drive em todos os dispositivos conectados a esta conta Google. O trabalho pendente pausa até reconectar a mesma conta. Gravações e configurações são mantidas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفقد Recly الوصول إلى Drive على جميع الأجهزة المرتبطة بحساب Google هذا. تتوقف المهام المعلّقة حتى إعادة ربط الحساب نفسه. تبقى التسجيلات والإعدادات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Google खाते से जुड़े सभी डिवाइस पर Recly का Drive एक्सेस हटेगा। वही खाता दोबारा कनेक्ट होने तक लंबित काम रुकेगा। रिकॉर्डिंग और सेटिंग बनी रहेंगी।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly потеряет доступ к Drive на всех устройствах с этим аккаунтом Google. Задачи приостановятся до повторного подключения того же аккаунта. Записи и настройки сохранятся."
          }
        }
      }
    },
    "Record locally. Connect Drive to upload.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record locally. Connect Drive to upload."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 녹음하고, Drive 연결 시 업로드합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルに録音します。アップロードにはDriveに接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地录音。连接Drive后即可上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機錄音。連接Drive後即可上傳。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba localmente. Conecta Drive para subir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez localement. Connectez Drive pour envoyer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal aufnehmen. Zum Hochladen Drive verbinden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave localmente. Conecte o Drive para enviar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل محليًا. اربط Drive للرفع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय रिकॉर्डिंग करें। अपलोड के लिए Drive कनेक्ट करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте локально. Подключите Drive для загрузки."
          }
        }
      }
    },
