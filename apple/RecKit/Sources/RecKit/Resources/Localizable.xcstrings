    "The upload queue on this Mac is wiped. Workflows and keys stay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending processing pauses until you reconnect the same account. Recordings, Drive files and keys stay."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 처리는 같은 계정에 다시 연결하면 이어집니다. 녹음, Drive 파일과 키는 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じアカウントに再接続するまで処理を一時停止します。録音、Driveのファイル、キーは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新连接同一账号前，待处理任务将暂停。录音、Drive文件和密钥都会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新連接同一帳戶前，待處理工作將暫停。錄音、Drive檔案和金鑰都會保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesamiento pendiente se pausa hasta reconectar la misma cuenta. Se conservan grabaciones, archivos de Drive y claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traitement en attente est suspendu jusqu’à la reconnexion du même compte. Enregistrements, fichiers Drive et clés sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausstehende Verarbeitung pausiert, bis dasselbe Konto erneut verbunden ist. Aufnahmen, Drive-Dateien und Schlüssel bleiben erhalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O processamento pendente pausa até reconectar a mesma conta. Gravações, arquivos do Drive e chaves são mantidos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف المعالجة المعلّقة حتى إعادة ربط الحساب نفسه. تبقى التسجيلات وملفات Drive والمفاتيح."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वही खाता फिर कनेक्ट होने तक लंबित प्रोसेसिंग रुकेगी। रिकॉर्डिंग, Drive फ़ाइलें और कुंजियाँ बनी रहेंगी।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработка приостановится до повторного подключения того же аккаунта. Записи, файлы Drive и ключи сохранятся."
          }
        }
      }
    },
