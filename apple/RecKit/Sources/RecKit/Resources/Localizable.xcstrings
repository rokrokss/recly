    "Drive access has to be allowed before anything can be uploaded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive access has to be allowed before anything can be uploaded"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive 권한을 허용해야 업로드할 수 있습니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードするにはDriveへのアクセスを許可してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传前需要允许访问Drive"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳前需要允許存取Drive"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes permitir el acceso a Drive antes de subir archivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à Drive doit être autorisé avant tout envoi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Hochladen muss der Drive-Zugriff erlaubt werden"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب السماح بالوصول إلى Drive قبل أي رفع"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपलोड से पहले Drive एक्सेस की अनुमति चाहिए"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед загрузкой нужно разрешить доступ к Drive"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso permitir o acesso ao Drive antes de enviar arquivos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário permitir o acesso ao Drive antes de carregar qualquer ficheiro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi consentire l’accesso a Drive prima di poter caricare qualcosa"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed przesłaniem czegokolwiek trzeba zezwolić na dostęp do Drive"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleme yapılabilmesi için önce Drive erişimine izin verilmelidir"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangang payagan ang access sa Drive bago makapag-upload ng kahit ano"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু আপলোড করার আগে Drive অ্যাক্সেসের অনুমতি দিতে হবে"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ بھی اپ لوڈ کرنے سے پہلے Drive تک رسائی کی اجازت دینی ہو گی"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni lazima uruhusu ufikiaji wa Drive kabla ya kupakia chochote"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần cho phép truy cập Drive trước khi có thể tải lên"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از هر بارگذاری باید اجازه دسترسی به Drive داده شود"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องอนุญาตการเข้าถึง Drive ก่อนจึงจะอัปโหลดได้"
          }
        }
      }
    },
    "Drive access needs your consent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive access needs your consent"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive 권한 동의가 필요합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Driveへのアクセスに同意が必要です"
          }
        },
        "zh-Hans": {
