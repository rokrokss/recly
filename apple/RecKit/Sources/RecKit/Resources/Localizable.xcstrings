        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج النسخ على الجهاز إلى نموذج Apple للتعرّف على الكلام."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पर ट्रांसक्रिप्शन के लिए Apple का स्पीच रिकग्निशन मॉडल चाहिए।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для расшифровки на устройстве нужна модель распознавания речи Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição no dispositivo precisa do modelo de reconhecimento de fala da Apple."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição no dispositivo requer o modelo de reconhecimento de voz da Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione sul dispositivo richiede il modello di riconoscimento vocale di Apple."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja na urządzeniu wymaga modelu rozpoznawania mowy Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz üzerinde transkripsiyon için Apple'ın konuşma tanıma modeli gerekir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng pag-transcribe sa device ang modelo ng speech recognition ng Apple."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইসে ট্রান্সক্রিপশনের জন্য Apple-এর স্পিচ রিকগনিশন মডেল প্রয়োজন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
