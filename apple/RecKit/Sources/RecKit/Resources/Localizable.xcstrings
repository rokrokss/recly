    "Every device signed in with this account loses access, not only this one. To leave just this Mac, sign out instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other devices using this Google authorization may also lose access."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 Google 승인을 사용하는 다른 기기도 접근 권한을 잃을 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このGoogle認証を使う他のデバイスもアクセスできなくなる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此Google授权的其他设备也可能失去访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此Google授權的其他裝置也可能失去存取權限。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros dispositivos que usan esta autorización de Google también podrían perder el acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres appareils utilisant cette autorisation Google peuvent aussi perdre l’accès."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Geräte mit dieser Google-Autorisierung können ebenfalls den Zugriff verlieren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Outros dispositivos que usam esta autorização Google também podem perder o acesso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تفقد الأجهزة الأخرى التي تستخدم تفويض Google هذا إمكانية الوصول أيضًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Google अनुमति का उपयोग करने वाले अन्य डिवाइस का एक्सेस भी हट सकता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие устройства с этой авторизацией Google тоже могут потерять доступ."
          }
        }
      }
    },
