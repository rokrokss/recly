    "Starts with a lowercase letter; lowercase, digits and underscores, up to 32": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts with a lowercase letter; lowercase, digits and underscores, up to 32"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소문자로 시작하고 소문자·숫자·밑줄 32자까지"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英小文字で始め、英小文字・数字・アンダースコアを32文字以内で入力"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以小写字母开头，仅含小写字母、数字和下划线，最多32个字符"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以小寫字母開頭，僅含小寫字母、數字和底線，最多32個字元"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza por una minúscula; minúsculas, números y guiones bajos, hasta 32 caracteres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence par une minuscule ; minuscules, chiffres et tirets bas, 32 caractères maximum"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnt mit Kleinbuchstaben; Kleinbuchstaben, Ziffern und Unterstriche, höchstens 32 Zeichen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ بحرف صغير؛ أحرف صغيرة وأرقام وشرطة سفلية، حتى 32 حرفًا"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटे अक्षर से शुरू; छोटे अक्षर, अंक और अंडरस्कोर, अधिकतम 32"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинается со строчной буквы; строчные буквы, цифры и подчёркивания, до 32 символов"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa com minúscula; minúsculas, números e sublinhados, até 32 caracteres"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa por uma letra minúscula; minúsculas, algarismos e sublinhados, até 32 caracteres"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con una lettera minuscola; minuscole, cifre e trattini bassi, fino a 32 caratteri"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaczyna się małą literą; małe litery, cyfry i podkreślenia, maks. 32 znaki"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük harfle başlar; küçük harf, rakam ve alt çizgi, en fazla 32 karakter"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagsisimula sa maliit na titik; maliliit na titik, numero at underscore, hanggang 32"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছোট হাতের অক্ষর দিয়ে শুরু; ছোট হাতের অক্ষর, অঙ্ক ও আন্ডারস্কোর, সর্বোচ্চ 32 অক্ষর"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چھوٹے حرف سے شروع؛ چھوٹے حروف، ہندسے اور انڈر اسکور، زیادہ سے زیادہ 32"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huanza na herufi ndogo; herufi ndogo, tarakimu na mistari ya chini, hadi herufi 32"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu bằng chữ thường; chỉ gồm chữ thường, chữ số và dấu gạch dưới, tối đa 32 ký tự"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با حرف کوچک شروع شود؛ فقط حروف کوچک، ارقام و زیرخط، حداکثر ۳۲ نویسه"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขึ้นต้นด้วยอักษรอังกฤษตัวพิมพ์เล็ก ใช้ได้เฉพาะตัวพิมพ์เล็ก ตัวเลข และขีดล่าง ไม่เกิน 32 ตัว"
          }
        }
      }
    },
