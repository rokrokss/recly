    "For a custom endpoint, also check its operator’s privacy policy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a custom endpoint, also check its operator’s privacy policy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 주소라면 해당 운영자의 개인정보 처리방침도 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自のエンドポイントを使う場合は、運営者のプライバシーポリシーも確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自定义端点时，请同时查看其运营方的隐私政策。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自訂端點時，請同時查看其營運方的隱私權政策。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si usas un endpoint personalizado, consulta también la política de privacidad de su operador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour un point de terminaison personnalisé, consultez aussi la politique de confidentialité de son opérateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie bei einem eigenen Endpunkt auch die Datenschutzerklärung seines Betreibers."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند استخدام نقطة اتصال مخصصة، راجع أيضًا سياسة خصوصية مشغّلها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कस्टम एंडपॉइंट के लिए उसके संचालक की गोपनीयता नीति भी जाँचें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для собственного адреса API также ознакомьтесь с политикой конфиденциальности его оператора."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para um endpoint personalizado, consulte também a política de privacidade do operador."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para um endpoint personalizado, consulte também a política de privacidade do respetivo operador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un endpoint personalizzato, consulta anche l’informativa sulla privacy del suo gestore."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W przypadku własnego punktu końcowego sprawdź też politykę prywatności jego operatora."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel bir uç nokta kullanıyorsanız işletmecisinin gizlilik politikasını da kontrol edin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa custom na endpoint, suriin din ang patakaran sa privacy ng operator nito."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাস্টম এন্ডপয়েন্টের ক্ষেত্রে এর পরিচালনাকারীর গোপনীয়তা নীতিও দেখে নিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حسب ضرورت اینڈ پوائنٹ کے لیے اس کے آپریٹر کی رازداری کی پالیسی بھی چیک کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwa endpoint maalum, kagua pia sera ya faragha ya mwendeshaji wake."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với điểm cuối tùy chỉnh, hãy xem thêm chính sách quyền riêng tư của bên vận hành."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای نقطه پایانی سفارشی، خط‌مشی رازداری گرداننده آن را هم بررسی کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากใช้เอนด์พอยต์ที่กำหนดเอง โปรดตรวจสอบนโยบายความเป็นส่วนตัวของผู้ดูแลเอนด์พอยต์นั้นด้วย"
          }
        }
      }
    },
