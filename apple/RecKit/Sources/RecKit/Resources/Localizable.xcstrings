    "Google Drive is out of space — free some up and try again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive is out of space — free some up and try again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive에 공간이 없습니다 — 정리한 뒤 다시 시도하세요"
          }
        },
        "ja": {
          "stringUnit": {
