    "A third-party AI speech recognition service. Recly does not operate it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A third-party AI speech recognition service. Recly does not operate it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제3자 AI 음성 인식 서비스입니다. Recly가 운영하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第三者のAI音声認識サービスです。Reclyは運営していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是第三方AI语音识别服务，并非由Recly运营。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是第三方AI語音辨識服務，並非由Recly營運。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un servicio de reconocimiento de voz con IA de un tercero. Recly no lo gestiona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un service tiers de reconnaissance vocale par IA. Recly ne l’exploite pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein KI-Spracherkennungsdienst eines Drittanbieters. Recly betreibt ihn nicht."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة تعرّف على الكلام بالذكاء الاصطناعي تابعة لجهة خارجية، ولا تديرها Recly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह किसी तृतीय पक्ष की AI वाक् पहचान सेवा है। Recly इसे संचालित नहीं करता।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторонний сервис распознавания речи на основе ИИ. Recly им не управляет."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um serviço de reconhecimento de fala com IA de terceiros. A Recly não o opera."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um serviço de reconhecimento de voz com IA de terceiros. Não é gerido pelo Recly."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un servizio di riconoscimento vocale con IA di terze parti. Recly non lo gestisce."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zewnętrzna usługa rozpoznawania mowy oparta na AI. Recly nie jest jej operatorem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üçüncü taraf bir yapay zeka konuşma tanıma hizmeti. Recly tarafından işletilmez."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Serbisyo ng third-party para sa AI speech recognition. Hindi ito pinapatakbo ng Recly."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি তৃতীয় পক্ষের একটি AI স্পিচ রিকগনিশন পরিষেবা। Recly এটি পরিচালনা করে না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فریق ثالث کی AI تقریر کی شناخت کی سروس۔ Recly اسے نہیں چلاتا۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huduma ya AI ya utambuzi wa matamshi inayotolewa na kampuni nyingine. Recly haiiendeshi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
