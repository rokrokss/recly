    "Google would not take the access away (%@) — do it in your Google account permissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google would not take the access away (%@) — do it in your Google account permissions"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google이 권한을 회수하지 못했습니다(%@) — Google 계정 권한 설정에서 직접 해제하세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleのアクセス権を取り消せませんでした（%@）。Googleアカウントの権限から取り消してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google未撤销访问权限（%@），请在Google账号权限中操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Google未撤銷存取權限（%@），請在Google帳戶權限中操作"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google no revocó el acceso (%@). Hazlo desde los permisos de tu cuenta Google"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google n’a pas révoqué l’accès (%@). Faites-le dans les autorisations de votre compte Google"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hat den Zugriff nicht entzogen (%@). In den Berechtigungen Ihres Google-Kontos widerrufen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُلغِ Google الوصول (%@). ألغِه من أذونات حساب Google"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google ने एक्सेस नहीं हटाया (%@)। अपने Google खाते की अनुमतियों में हटाएँ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Google не отозвал доступ (%@). Отзовите его в разрешениях аккаунта Google"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Google não revogou o acesso (%@). Faça isso nas permissões da sua conta Google"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Google não retirou o acesso (%@) — faça-o nas permissões da sua conta Google"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Google non ha revocato l’accesso (%@): fallo dalle autorizzazioni del tuo account Google"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google nie cofnął dostępu (%@) — zrób to w uprawnieniach swojego konta Google"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google erişimi kaldırmadı (%@) — bunu Google hesabı izinlerinizden yapın"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaw bawiin ng Google ang access (%@) — gawin ito sa mga pahintulot ng iyong Google account"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Google অ্যাক্সেস সরায়নি (%@); আপনার Google অ্যাকাউন্টের অনুমতিতে গিয়ে সরিয়ে দিন"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Google نے رسائی نہیں ہٹائی (%@) — اپنے Google اکاؤنٹ کی اجازتوں میں ہٹائیں"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Google imekataa kuondoa ufikiaji (%@) — fanya hivyo katika ruhusa za akaunti yako ya Google"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google không thu hồi quyền truy cập (%@) — hãy tự thu hồi trong phần quyền của tài khoản Google"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی توسط Google لغو نشد (%@)؛ این کار را در اجازه‌های حساب Google خود انجام دهید"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Google ไม่ยอมเพิกถอนการเข้าถึง (%@) โปรดเพิกถอนในสิทธิ์ของบัญชี Google ของคุณ"
          }
        }
      }
    },
