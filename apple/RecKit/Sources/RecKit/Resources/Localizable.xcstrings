    "Disconnected. The recordings on this Mac were left where they are.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected. The recordings on this Mac were left where they are."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 해제했습니다. 이 Mac의 녹음은 그대로 남아 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を解除しました。このMacの録音は残っています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已断开连接。此Mac上的录音保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已中斷連線。此Mac上的錄音保持不變。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado. Las grabaciones de este Mac se han conservado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté. Les enregistrements de ce Mac sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Getrennt. Die Aufnahmen auf diesem Mac bleiben erhalten."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الفصل. بقيت التسجيلات على هذا الـMac كما هي."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्कनेक्ट किया गया। इस Mac की रिकॉर्डिंग यथावत हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключено. Записи на этом Mac сохранены."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado. As gravações deste Mac foram mantidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado. As gravações neste Mac foram mantidas onde estão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scollegato. Le registrazioni su questo Mac restano dove sono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłączono. Nagrania na tym Macu pozostały na miejscu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı kesildi. Bu Mac'teki kayıtlara dokunulmadı."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadiskonekta. Hindi ginalaw ang mga recording sa Mac na ito."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিসকানেক্ট করা হয়েছে। এই Mac-এর রেকর্ডিং যেমন ছিল তেমনই আছে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منقطع ہو گیا۔ اس Mac پر موجود ریکارڈنگز جوں کی توں رہیں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imetenganishwa. Rekodi zilizo kwenye Mac hii zimeachwa zilipo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ngắt kết nối. Các bản ghi âm trên máy Mac này vẫn được giữ nguyên."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال قطع شد. ضبط‌های روی این Mac دست‌نخورده باقی ماندند."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการเชื่อมต่อแล้ว การบันทึกเสียงใน Mac เครื่องนี้ยังคงอยู่ที่เดิม"
          }
        }
      }
    },
