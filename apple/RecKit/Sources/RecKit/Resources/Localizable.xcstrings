        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل النسخ بعد. ستظهر النتيجة هنا عند جاهزيتها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्शन अभी पूरा नहीं है। तैयार होने पर परिणाम यहाँ दिखेगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка ещё не завершена. Результат появится здесь, когда будет готов."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição ainda não terminou. O resultado aparecerá aqui quando estiver pronto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição ainda não terminou. O resultado aparece aqui quando estiver pronto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione non è ancora terminata. Il risultato apparirà qui quando sarà pronto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja jeszcze się nie zakończyła. Wynik pojawi się tutaj, gdy będzie gotowy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsiyon henüz bitmedi. Sonuç hazır olduğunda burada görünecek."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa tapos ang pag-transcribe. Lalabas dito ang resulta kapag handa na."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সক্রিপশন এখনও শেষ হয়নি। প্রস্তুত হলে ফলাফল এখানে দেখা যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسکرپشن ابھی مکمل نہیں ہوا۔ تیار ہونے پر نتیجہ یہاں ظاہر ہو گا۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unukuzi bado haujakamilika. Matokeo yataonekana hapa yakiwa tayari."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chép lời chưa hoàn tất. Kết quả sẽ hiển thị ở đây khi sẵn sàng."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رونویسی هنوز تمام نشده است. نتیجه پس از آماده شدن اینجا نمایش داده می‌شود."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถอดเสียงยังไม่เสร็จ ผลลัพธ์จะแสดงที่นี่เมื่อพร้อม"
          }
        }
      }
    },
    "Transcription could not finish. Check this recording in the list for the next action.": {
