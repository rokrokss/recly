          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Drive تک رسائی کی دوبارہ اجازت دینی ہو گی"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni lazima uruhusu tena ufikiaji wa Google Drive"
