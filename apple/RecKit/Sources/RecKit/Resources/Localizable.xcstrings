    "Recordings not yet in Drive, kept on this Mac: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordings not yet in Drive, kept on this Mac: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 Drive에 올라가지 않은 녹음 %@건은 이 Mac에 남습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Driveに未送信の録音%@件は、このMacに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未上传至Drive的%@条录音将保留在此Mac上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未上傳至Drive的%@筆錄音將保留在此Mac上。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones aún no subidas a Drive se quedan en este Mac: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements non envoyés à Drive restent sur ce Mac : %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht zu Drive übertragene Aufnahmen bleiben auf diesem Mac: %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيلات التي لم تصل إلى Drive وتبقى على هذا الـMac: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive तक नहीं पहुँची रिकॉर्डिंग इस Mac पर रहेंगी: %@।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё не загруженные в Drive записи останутся на этом Mac: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações ainda não enviadas ao Drive ficam neste Mac: %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravações por carregar para o Drive, mantidas neste Mac: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazioni non ancora su Drive, conservate su questo Mac: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrania nieprzesłane jeszcze na Drive, zachowane na tym Macu: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz Drive'a yüklenmeyen, bu Mac'te tutulan kayıtlar: %@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga recording na wala pa sa Drive, nananatili sa Mac na ito: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও Drive-এ না যাওয়া রেকর্ডিং এই Mac-এ রাখা হয়েছে: %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو ریکارڈنگز ابھی Drive میں نہیں، اس Mac پر رکھی گئیں: %@"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekodi zilizobaki kwenye Mac hii ambazo bado hazijafika kwenye Drive: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bản ghi âm chưa được tải lên Drive vẫn được giữ trên máy Mac này"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط‌هایی که هنوز به Drive نرسیده‌اند و روی این Mac می‌مانند: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกเสียงที่ยังไม่อยู่ใน Drive ซึ่งเก็บไว้ใน Mac เครื่องนี้: %@"
          }
        }
      }
    },
