    "%@ part(s) have not reached Drive yet and are deleted with it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ part(s) have not reached Drive yet and are deleted with it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 Drive에 올라가지 않은 파트 %@개가 함께 지워집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Driveに未送信の%@パートも削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未上传至Drive的%@段音频也将删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未上傳至Drive的%@段音訊也將刪除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán también las partes aún no subidas a Drive: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parties non encore envoyées à Drive seront aussi supprimées : %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht zu Drive übertragene Teile werden ebenfalls gelöscht: %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As partes ainda não enviadas ao Drive também serão excluídas: %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف أيضًا الأجزاء التي لم تصل إلى Drive وعددها %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive तक नहीं पहुँचे भाग भी हटेंगे: %@।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также удалятся ещё не загруженные в Drive части: %@."
          }
        }
      }
    },
    "%@ recording(s) have not reached Drive yet and stay on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recording(s) have not reached Drive yet and stay on this Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 Drive에 올라가지 않은 녹음 %@건은 이 Mac에 남습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Driveに未送信の録音%@件は、このMacに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未上传至Drive的%@条录音将保留在此Mac上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未上傳至Drive的%@筆錄音將保留在此Mac上。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones aún no subidas a Drive se quedan en este Mac: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements non envoyés à Drive restent sur ce Mac : %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht zu Drive übertragene Aufnahmen bleiben auf diesem Mac: %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações ainda não enviadas ao Drive ficam neste Mac: %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيلات التي لم تصل إلى Drive وتبقى على هذا الـMac: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive तक नहीं पहुँची रिकॉर्डिंग इस Mac पर रहेंगी: %@।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё не загруженные в Drive записи останутся на этом Mac: %@."
          }
        }
      }
    },
