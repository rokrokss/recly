          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cota ou o limite de requisições do provedor foi atingido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O fornecedor esgotou a quota ou está a limitar os pedidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fornitore ha esaurito la quota o sta limitando le richieste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczerpano limit u dostawcy lub dostawca ogranicza liczbę żądań."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcının kotası doldu veya istek hızı sınırlanıyor."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubos na ang quota ng provider o nililimitahan nito ang mga request."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রদানকারীর কোটা শেষ, অথবা অনুরোধের হার সীমিত করা হচ্ছে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فراہم کنندہ کا کوٹا ختم ہو گیا ہے یا وہ درخواستوں کی شرح محدود کر رہا ہے۔"
          }
