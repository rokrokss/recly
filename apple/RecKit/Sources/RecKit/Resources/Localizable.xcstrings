        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được ghi trên thiết bị khác. Khi xóa, bản ghi âm sẽ bị xóa khỏi iCloud và mọi thiết bị."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در دستگاه دیگری ضبط شده است. حذف، آن را از iCloud و همه دستگاه‌ها پاک می‌کند."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกจากอุปกรณ์อื่น การลบจะนำออกจาก iCloud และจากทุกอุปกรณ์"
          }
        }
      }
    },
    "Audio not yet in iCloud is deleted with it.": {
