    "Could not check the Google sign-in — try Disconnect again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not check the Google connection. Try disconnecting Drive again in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 연결 상태를 확인하지 못했습니다. 설정에서 Drive 연결 해제를 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleとの接続を確認できませんでした。設定でDriveの接続解除を再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查Google连接。请在设置中重试断开Drive。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查Google連線。請在設定中重試中斷Drive連線。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo comprobar la conexión con Google. Intenta desconectar Drive otra vez en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier la connexion Google. Réessayez de déconnecter Drive dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Google-Verbindung konnte nicht geprüft werden. Trennen Sie Drive erneut in den Einstellungen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a conexão Google. Tente desconectar o Drive novamente em Configurações."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من اتصال Google. حاول فصل Drive مجددًا من الإعدادات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google कनेक्शन जाँचा नहीं जा सका। सेटिंग में Drive को फिर डिस्कनेक्ट करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить подключение Google. Попробуйте снова отключить Drive в настройках."
          }
        }
      }
    },
