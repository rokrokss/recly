            "value": "এখন আবার চেষ্টা করা যাবে না"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس وقت دوبارہ کوشش نہیں کی جا سکتی"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haiwezekani kujaribu tena kwa sasa"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không thể thử lại"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال حاضر امکان تلاش مجدد نیست"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองอีกครั้งตอนนี้ไม่ได้"
          }
        }
      }
    },
    "Transcription is waiting. Check this recording in the list for what it needs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription is waiting. Check this recording in the list for what it needs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사가 대기 중입니다. 목록에서 이 녹음에 필요한 조치를 확인해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしは待機中です。一覧でこの録音に必要な操作を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录正在等待。请在列表中查看此录音需要的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉錄正在等待。請在列表中查看此錄音需要的操作。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción está en espera. Revisa en la lista qué necesita esta grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription est en attente. Consultez la liste pour voir ce dont cet enregistrement a besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transkription wartet. Prüfen Sie in der Liste, was diese Aufnahme benötigt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ في الانتظار. راجع القائمة لمعرفة ما يحتاجه هذا التسجيل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्शन प्रतीक्षा में है। सूची में देखें कि इस रिकॉर्डिंग को क्या चाहिए।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка ожидает. Посмотрите в списке, что нужно для этой записи."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição está aguardando. Veja na lista o que esta gravação precisa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição está em espera. Consulte esta gravação na lista para saber o que é necessário."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione è in attesa. Controlla questa registrazione nell’elenco per vedere cosa serve."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja czeka. Sprawdź to nagranie na liście, aby zobaczyć, czego potrzebuje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsiyon bekliyor. Neyin gerektiğini görmek için listede bu kayda bakın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naghihintay ang pag-transcribe. Tingnan ang recording na ito sa listahan para malaman ang kailangan nito."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সক্রিপশন অপেক্ষায় আছে। এই রেকর্ডিংয়ের জন্য কোন পদক্ষেপ দরকার, তা তালিকায় দেখুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسکرپشن منتظر ہے۔ فہرست میں یہ ریکارڈنگ دیکھیں کہ اسے کیا درکار ہے۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unukuzi unasubiri. Angalia rekodi hii kwenye orodha ili ujue kinachohitajika."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chép lời đang chờ. Hãy xem bản ghi âm này trong danh sách để biết cần làm gì."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رونویسی در انتظار است. برای اینکه ببینید این ضبط به چه نیاز دارد، آن را در فهرست بررسی کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถอดเสียงกำลังรอ ตรวจสอบการบันทึกเสียงนี้ในรายการเพื่อดูสิ่งที่ต้องใช้"
          }
        }
      }
    },
    "Audio not yet in Drive is deleted with it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio not yet in Drive is deleted with it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 Drive에 올라가지 않은 오디오도 함께 지워집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Driveに未送信の音声も削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未上传至Drive的音频也将删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未上傳至Drive的音訊也將刪除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se eliminará el audio que aún no se ha subido a Drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio pas encore envoyé à Drive sera aussi supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht zu Drive übertragenes Audio wird ebenfalls gelöscht."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف أيضًا الصوت الذي لم يصل إلى Drive بعد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive तक नहीं पहुँचा ऑडियो भी हटेगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также удалится аудио, ещё не загруженное в Drive."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio ainda não enviado ao Drive também será excluído."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio que ainda não está no Drive também é eliminado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà eliminato anche l’audio non ancora su Drive."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio, którego nie ma jeszcze na Drive, również zostanie usunięte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz Drive'a yüklenmemiş ses de onunla birlikte silinir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasama ring made-delete ang audio na wala pa sa Drive."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে অডিও এখনও Drive-এ পৌঁছায়নি, সেটিও মুছে যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو آڈیو ابھی Drive میں نہیں، وہ بھی اس کے ساتھ حذف ہو جائے گا۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauti ambayo bado haijafika kwenye Drive itafutwa pia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh chưa được tải lên Drive cũng sẽ bị xóa theo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدایی که هنوز به Drive نرسیده است نیز همراه آن حذف می‌شود."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงที่ยังไม่อยู่ใน Drive จะถูกลบไปด้วย"
          }
        }
      }
    },
    "iCloud Drive isn’t available. In Settings, under iCloud, check that iCloud Drive and Recly are turned on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive isn’t available. In Settings, under iCloud, check that iCloud Drive and Recly are turned on."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive를 쓸 수 없습니다. 설정의 iCloud에서 iCloud Drive와 Recly가 켜져 있는지 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Driveを利用できません。設定のiCloudで、iCloud DriveとReclyがオンになっているか確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用iCloud Drive。请在“设置”的iCloud中确认iCloud Drive和Recly已打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用iCloud Drive。請在「設定」的iCloud中確認iCloud Drive和Recly已開啟。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive no está disponible. En Ajustes, dentro de iCloud, comprueba que iCloud Drive y Recly estén activados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive n’est pas disponible. Dans Réglages, sous iCloud, vérifiez que iCloud Drive et Recly sont activés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive ist nicht verfügbar. In den Einstellungen unter iCloud prüfen, ob iCloud Drive und Recly aktiviert sind."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏iCloud Drive غير متاح. في الإعدادات، ضمن iCloud، تحقّق من تفعيل iCloud Drive وRecly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive उपलब्ध नहीं है। सेटिंग में iCloud के अंदर जाँचें कि iCloud Drive और Recly चालू हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive недоступен. В Настройках в разделе iCloud проверьте, что iCloud Drive и Recly включены."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud Drive não está disponível. Nos Ajustes, em iCloud, verifique se o iCloud Drive e o Recly estão ativados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud Drive não está disponível. Em Definições, em iCloud, verifique se o iCloud Drive e o Recly estão ativados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive non è disponibile. In Impostazioni, sotto iCloud, verifica che iCloud Drive e Recly siano attivati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive jest niedostępny. W Ustawieniach w sekcji iCloud sprawdź, czy iCloud Drive i Recly są włączone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive kullanılamıyor. Ayarlar'da iCloud bölümünde iCloud Drive'ın ve Recly'nin açık olduğundan emin olun."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi available ang iCloud Drive. Sa Settings, sa ilalim ng iCloud, tiyaking naka-on ang iCloud Drive at Recly."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive উপলভ্য নয়। সেটিংসে iCloud-এর মধ্যে দেখে নিন iCloud Drive ও Recly চালু আছে কিনা।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive دستیاب نہیں۔ ترتیبات میں iCloud کے تحت چیک کریں کہ iCloud Drive اور Recly آن ہیں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive haipatikani. Katika Mipangilio, chini ya iCloud, hakikisha kuwa iCloud Drive na Recly zimewashwa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive không khả dụng. Trong Cài đặt, ở mục iCloud, hãy kiểm tra xem iCloud Drive và Recly đã được bật chưa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به iCloud Drive ممکن نیست. در تنظیمات، بخش iCloud، بررسی کنید که iCloud Drive و Recly روشن باشند."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive ไม่พร้อมใช้งาน ในการตั้งค่า ใต้ iCloud ให้ตรวจสอบว่าเปิด iCloud Drive และ Recly อยู่"
          }
        }
      }
    },
    "iCloud is out of space — free some up and try again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is out of space — free some up and try again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 공간이 없습니다 — 정리한 뒤 다시 시도하세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudの容量が不足しています。空きを作って再試行してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud空间不足，请释放空间后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud空間不足，請釋出空間後重試"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no tiene espacio. Libera espacio y vuelve a intentarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est plein. Libérez de l’espace et réessayez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist voll. Speicherplatz freigeben und erneut versuchen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة iCloud ممتلئة. أفرغ بعض المساحة وأعد المحاولة"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud में जगह नहीं है। जगह खाली करके फिर कोशिश करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В iCloud закончилось место. Освободите его и повторите попытку"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está sem espaço. Libere espaço e tente novamente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está sem espaço — liberte espaço e tente novamente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio esaurito su iCloud: liberane un po’ e riprova"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak miejsca w iCloud — zwolnij trochę miejsca i spróbuj ponownie"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud'da yer kalmadı — biraz yer açıp yeniden deneyin"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puno na ang iCloud — magbakante ng espasyo at subukang muli"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-এ জায়গা নেই; কিছু জায়গা খালি করে আবার চেষ্টা করুন"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud میں جگہ ختم ہو گئی ہے — کچھ جگہ خالی کریں اور دوبارہ کوشش کریں"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud imejaa — futa vitu ili kupata nafasi kisha ujaribu tena"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud đã hết dung lượng — hãy giải phóng bớt rồi thử lại"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فضای iCloud پر است؛ مقداری فضا آزاد کنید و دوباره امتحان کنید"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ iCloud เต็ม เพิ่มพื้นที่ว่างแล้วลองอีกครั้ง"
          }
        }
      }
    },
