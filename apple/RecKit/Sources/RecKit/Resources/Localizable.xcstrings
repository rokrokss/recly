    "Up to 50 terms, 40 characters each.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 50 terms, 40 characters each."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 50개, 각 40자까지입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大50語、各40文字までです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多50个词条，每个不超过40个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多50個詞條，每個不超過40個字元。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta 50 términos de 40 caracteres como máximo cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à 50 termes de 40 caractères maximum chacun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 50 Begriffe mit je höchstens 40 Zeichen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até 50 termos, com até 40 caracteres cada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Até 50 termos, com até 40 caracteres cada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى 50 مصطلح، وكل منها حتى 40 حرفًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम 50 शब्द, हर एक में 40 वर्ण तक।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До 50 терминов, не более 40 символов каждый."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a 50 termini, di massimo 40 caratteri ciascuno."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do 50 terminów, każdy do 40 znaków."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla 50 terim, her biri en fazla 40 karakter."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanggang 50 termino, hanggang 40 character bawat isa."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বোচ্চ 50টি পরিভাষা, প্রতিটি 40 অক্ষর পর্যন্ত।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ سے زیادہ 50 اصطلاحات، ہر ایک 40 حروف تک۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadi istilahi 50, kila moja hadi herufi 40."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa 50 mục, mỗi mục tối đa 40 ký tự."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حداکثر ۵۰ اصطلاح، هر کدام حداکثر ۴۰ نویسه."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สูงสุด 50 คำ คำละไม่เกิน 40 ตัวอักษร"
          }
        }
      }
    },
    "Names and terms to spell correctly. They are sent with the audio to %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and terms to spell correctly. They are sent with the audio to %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확히 받아 적을 이름과 용어입니다. 오디오와 함께 %@에 보냅니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正しく表記したい名前や用語です。音声と一緒に%@に送信されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要准确转写的名称和术语。会与音频一起发送到%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要正確轉寫的名稱和術語。會與音訊一起傳送到%@。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres y términos que deben escribirse correctamente. Se envían con el audio a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms et termes à orthographier correctement. Ils sont envoyés avec l’audio à %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen und Begriffe, die richtig geschrieben werden sollen. Sie werden mit dem Audio an %@ gesendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes e termos para escrever corretamente. Eles são enviados com o áudio para %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes e termos a escrever corretamente. São enviados com o áudio para %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسماء ومصطلحات يجب كتابتها بشكل صحيح. تُرسل مع الصوت إلى %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे नाम और शब्द जिन्हें सही लिखा जाना चाहिए। ये ऑडियो के साथ %@ को भेजे जाते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена и термины, которые нужно писать правильно. Они отправляются вместе с аудио в сервис %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomi e termini da scrivere correttamente. Vengono inviati con l’audio a %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy i terminy do poprawnego zapisu. Są wysyłane razem z audio do usługi %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğru yazılması gereken adlar ve terimler. Sesle birlikte %@ hizmetine gönderilir."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga pangalan at terminong dapat tama ang baybay. Ipinapadala ang mga ito kasama ng audio sa %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব নাম ও পরিভাষা সঠিক বানানে লিখতে হবে। এগুলো অডিওর সাথে %@-এ পাঠানো হয়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ نام اور اصطلاحات جنہیں درست لکھنا ہے۔ یہ آڈیو کے ساتھ %@ کو بھیجی جاتی ہیں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Majina na istilahi zinazopaswa kuandikwa kwa usahihi. Hutumwa pamoja na sauti kwa %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên và thuật ngữ cần viết đúng. Chúng được gửi kèm âm thanh đến %@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
