    "Could not save a usable Drive connection. Try connecting again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save a usable Drive connection. Try connecting again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive 연결 정보를 저장하지 못했습니다. 다시 연결해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なDrive接続を保存できませんでした。もう一度接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存有效的Drive连接。请重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存有效的Drive連線。請重新連接。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar una conexión válida con Drive. Vuelve a conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer une connexion Drive valide. Reconnectez-vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine nutzbare Drive-Verbindung gespeichert. Bitte erneut verbinden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar uma conexão válida com o Drive. Conecte novamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ اتصال صالح بـDrive. حاول الربط مجددًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोग योग्य Drive कनेक्शन सहेजा नहीं जा सका। फिर कनेक्ट करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить рабочее подключение Drive. Подключитесь снова."
          }
        }
      }
    },
    "Local transcription is unavailable on this device. Choose another transcription method.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local transcription is unavailable on this device. Choose another transcription method."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 로컬 전사를 사용할 수 없습니다. 전사 방식을 변경해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではローカル文字起こしを利用できません。別の方法を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不支持本地转录，请选择其他转录方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置不支援本機轉錄，請選擇其他轉錄方式。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción local no está disponible en este dispositivo. Elige otro método."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription locale est indisponible sur cet appareil. Choisissez une autre méthode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Transkription ist auf diesem Gerät nicht verfügbar. Wählen Sie eine andere Methode."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição local não está disponível neste dispositivo. Escolha outro método."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ المحلي غير متاح على هذا الجهاز. اختر طريقة أخرى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर स्थानीय ट्रांसक्रिप्शन उपलब्ध नहीं है। दूसरा तरीका चुनें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная расшифровка недоступна на этом устройстве. Выберите другой способ."
          }
        }
      }
    },
    "Prepare the speech model in transcription settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
