        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعدّ نموذج الكلام في إعدادات النسخ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्शन सेटिंग में स्पीच मॉडल तैयार करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовьте речевую модель в настройках расшифровки."
          }
        }
      }
    },
    "alert.localDiarization": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This local engine does not support speaker identification. Turn it off or choose an external API."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로컬 엔진은 화자 구분을 지원하지 않습니다. 화자 구분을 끄거나 외부 API를 선택해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このローカルエンジンは話者識別に対応していません。無効にするか、外部APIを選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此本地引擎不支持说话人识别。请关闭该功能或选择外部API。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此本機引擎不支援說話者識別。請關閉該功能或選擇外部API。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este motor local no identifica hablantes. Desactiva la función o elige una API externa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce moteur local n’identifie pas les locuteurs. Désactivez cette option ou choisissez une API externe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese lokale Engine unterstützt keine Sprechererkennung. Deaktivieren Sie sie oder wählen Sie eine externe API."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mecanismo local não identifica falantes. Desative a função ou escolha uma API externa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المحرك المحلي لا يدعم تحديد المتحدثين. عطّل الميزة أو اختر API خارجيًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्थानीय इंजन वक्ता पहचान का समर्थन नहीं करता। इसे बंद करें या बाहरी API चुनें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот локальный движок не распознаёт говорящих. Выключите эту функцию или выберите внешний API."
          }
        }
      }
    },
