          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déconnecter Drive. Réessayez dans Réglages. (%@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive konnte nicht getrennt werden. Versuchen Sie es in den Einstellungen erneut. (%@)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فصل Drive. أعد المحاولة من الإعدادات. (%@)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive डिस्कनेक्ट नहीं हो सका। सेटिंग में फिर कोशिश करें। (%@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отключить Drive. Повторите попытку в настройках. (%@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desconectar o Drive. Tente novamente em Configurações. (%@)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desligar o Drive. Tente novamente nas Definições. (%@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scollegare Drive. Riprova in Impostazioni. (%@)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odłączyć Drive. Spróbuj ponownie w Ustawieniach. (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive bağlantısı kesilemedi. Ayarlar'da yeniden deneyin. (%@)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maidiskonekta ang Drive. Subukang muli sa Mga Setting. (%@)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive ডিসকানেক্ট করা যায়নি। সেটিংসে আবার চেষ্টা করুন। (%@)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive منقطع نہیں ہو سکا۔ ترتیبات میں دوبارہ کوشش کریں۔ (%@)"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kutenganisha Drive. Jaribu tena katika Mipangilio. (%@)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể ngắt kết nối Drive. Hãy thử lại trong Cài đặt. (%@)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال Drive قطع نشد. دوباره در تنظیمات امتحان کنید. (%@)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการเชื่อมต่อ Drive ไม่ได้ ลองอีกครั้งในการตั้งค่า (%@)"
          }
        }
      }
    },
    "Google still lists Recly — remove it at myaccount.google.com/permissions": {
