    "Permission covers future recordings on this device. You can withdraw it in Settings → Privacy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission covers future recordings on this device. You can withdraw it in Settings → Privacy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 이 기기의 이후 녹음에도 적용됩니다. 설정 → 개인정보 보호에서 철회할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この許可は、このデバイスで今後行う録音にも適用されます。「設定→プライバシー」で取り消せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此权限适用于此设备上的后续录音，可在“设置→隐私”中撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此權限適用於此裝置上的後續錄音，可在「設定→隱私權」中撤銷。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso cubre futuras grabaciones en este dispositivo. Puedes retirarlo en Ajustes → Privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation couvre les futurs enregistrements sur cet appareil. Retirez-la dans Réglages → Confidentialité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung gilt für zukünftige Aufnahmen auf diesem Gerät. Unter Einstellungen → Datenschutz widerrufbar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل الإذن التسجيلات المستقبلية على هذا الجهاز. يمكنك سحبه من الإعدادات ← الخصوصية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति इस डिवाइस की आगे की रिकॉर्डिंग पर भी लागू है। इसे सेटिंग → गोपनीयता में वापस ले सकते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение действует и на будущие записи на этом устройстве. Его можно отозвать в Настройки → Конфиденциальность."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão abrange futuras gravações neste dispositivo. Revogue em Configurações → Privacidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão abrange futuras gravações neste dispositivo. Pode retirá-la em Definições → Privacidade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorizzazione vale per le registrazioni future su questo dispositivo. Puoi revocarla in Impostazioni → Privacy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgoda obejmuje przyszłe nagrania na tym urządzeniu. Możesz ją wycofać w Ustawieniach → Prywatność."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin, bu cihazdaki sonraki kayıtlar için geçerlidir. Ayarlar → Gizlilik bölümünden geri çekebilirsiniz."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Saklaw ng pahintulot ang mga susunod na recording sa device na ito. Maaari mo itong bawiin sa Mga Setting → Privacy."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অনুমতি এই ডিভাইসের ভবিষ্যৎ রেকর্ডিংয়েও প্রযোজ্য। সেটিংস → গোপনীয়তা-তে গিয়ে এটি প্রত্যাহার করতে পারেন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اجازت اس آلے پر آئندہ ریکارڈنگز پر لاگو ہوتی ہے۔ آپ اسے ترتیبات ← رازداری میں واپس لے سکتے ہیں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusa hii inahusu rekodi zijazo kwenye kifaa hiki. Unaweza kuibatilisha katika Mipangilio → Faragha."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền này áp dụng cho các bản ghi âm sau này trên thiết bị này. Bạn có thể rút lại trong Cài đặt → Quyền riêng tư."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این اجازه شامل ضبط‌های آینده در این دستگاه می‌شود. می‌توانید آن را در تنظیمات ← حریم خصوصی پس بگیرید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอนุญาตนี้ครอบคลุมการบันทึกเสียงในอนาคตบนอุปกรณ์นี้ คุณถอนการอนุญาตได้ในการตั้งค่า → ความเป็นส่วนตัว"
          }
        }
      }
    },
    "Permission is needed before sending to this destination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission is needed before sending to this destination"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대상으로 전송하기 전에 허용이 필요합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この送信先への転送には許可が必要です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送到此目标前需要授权"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送至此目的地前需要授權"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita permiso para enviar a este destino"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autorisation est nécessaire pour cette destination"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Senden an dieses Ziel ist eine Berechtigung nötig"
          }
        },
        "ar": {
          "stringUnit": {
