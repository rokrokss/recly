        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزوّد النسخ هذا غير متاح في تطبيق iPhone. اختر مزوّدًا آخر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ट्रांसक्रिप्शन प्रदाता iPhone ऐप में उपलब्ध नहीं है। कोई दूसरा प्रदाता चुनें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот провайдер расшифровки недоступен в приложении для iPhone. Выберите другого провайдера."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este provedor não está disponível no app para iPhone. Escolha outro provedor."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este fornecedor de transcrição não está disponível na aplicação para iPhone. Escolha outro fornecedor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo fornitore di trascrizione non è disponibile nell’app per iPhone. Scegli un altro fornitore."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten dostawca transkrypcji jest niedostępny w aplikacji na iPhone’a. Wybierz innego dostawcę."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu transkripsiyon sağlayıcısı iPhone uygulamasında kullanılamaz. Başka bir sağlayıcı seçin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi available ang provider ng pag-transcribe na ito sa iPhone app. Pumili ng ibang provider."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ট্রান্সক্রিপশন প্রদানকারী iPhone অ্যাপে উপলভ্য নয়। অন্য কোনো প্রদানকারী বেছে নিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ٹرانسکرپشن فراہم کنندہ iPhone ایپ میں دستیاب نہیں۔ کوئی اور فراہم کنندہ منتخب کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtoa huduma huyu wa unukuzi hapatikani katika programu ya iPhone. Chagua mtoa huduma mwingine."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp dịch vụ chép lời này không khả dụng trong ứng dụng iPhone. Hãy chọn nhà cung cấp khác."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ارائه‌دهنده رونویسی در برنامه iPhone در دسترس نیست. ارائه‌دهنده دیگری انتخاب کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการถอดเสียงนี้ใช้ไม่ได้ในแอป iPhone เลือกผู้ให้บริการอื่น"
          }
        }
      }
    },
    "Waiting to verify your App Store region before continuing transcription.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting to verify your App Store region before continuing transcription."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사를 계속하기 전에 App Store 지역 확인을 기다리고 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしを続ける前に、App Storeの地域を確認しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待验证App Store地区，以继续转录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待驗證App Store地區，以繼續轉錄。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a verificar tu región de App Store para continuar la transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de votre région App Store avant de poursuivre la transcription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Prüfung Ihrer App-Store-Region, bevor die Transkription fortgesetzt wird."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بانتظار التحقق من منطقة App Store قبل متابعة النسخ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्शन जारी रखने से पहले App Store क्षेत्र की पुष्टि की प्रतीक्षा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание проверки региона App Store перед продолжением расшифровки."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando a verificação da região da App Store para continuar a transcrição."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "À espera de verificar a sua região da App Store para continuar a transcrição."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa della verifica della tua regione dell’App Store per continuare la trascrizione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na weryfikację regionu App Store przed kontynuowaniem transkrypcji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsiyona devam etmeden önce App Store bölgenizin doğrulanması bekleniyor."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinihintay ang pag-verify ng iyong rehiyon ng App Store bago ituloy ang pag-transcribe."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সক্রিপশন চালিয়ে যাওয়ার আগে আপনার App Store অঞ্চল যাচাইয়ের অপেক্ষায়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسکرپشن جاری رکھنے سے پہلے آپ کے App Store علاقے کی تصدیق کا انتظار ہے۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inasubiri kuthibitisha eneo lako la App Store kabla ya kuendelea na unukuzi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ xác minh khu vực App Store của bạn trước khi tiếp tục chép lời."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در انتظار تأیید منطقه App Store شما پیش از ادامه رونویسی."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังรอตรวจสอบภูมิภาค App Store ของคุณก่อนถอดเสียงต่อ"
          }
        }
      }
    },
