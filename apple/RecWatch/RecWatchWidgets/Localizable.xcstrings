    "Shows the recording state; tap to start.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the recording state; tap to start."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 상태를 보고, 눌러 시작합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音の状態を表示します。タップして開始。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示录音状态，轻点开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示錄音狀態，點一下開始。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el estado de grabación; toca para iniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l’état de l’enregistrement ; touchez pour démarrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Aufnahmestatus; zum Starten tippen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض حالة التسجيل؛ اضغط للبدء."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग की स्थिति दिखाता है; शुरू करने के लिए टैप करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает состояние записи; нажмите для начала."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o estado da gravação; toque para iniciar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o estado da gravação; toque para iniciar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra lo stato della registrazione; tocca per avviare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje stan nagrywania; stuknij, aby rozpocząć."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt durumunu gösterir; başlatmak için dokunun."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita ang status ng pag-record; i-tap para magsimula."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিংয়ের অবস্থা দেখায়; শুরু করতে ট্যাপ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ کی حالت دکھاتا ہے؛ شروع کرنے کے لیے تھپتھپائیں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huonyesha hali ya kurekodi; gusa ili uanze."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị trạng thái ghi âm; chạm để bắt đầu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وضعیت ضبط را نشان می‌دهد؛ برای شروع ضربه بزنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงสถานะการบันทึกเสียง แตะเพื่อเริ่ม"
          }
        }
      }
    },
