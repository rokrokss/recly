<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened runtime resource access (docs/12 M9). The runtime is on for Release, and a hardened
  process is denied the microphone unless the signature carries this exception — the app is not
  sandboxed, so `com.apple.security.*` here is the hardened-runtime entitlement and not a sandbox
  grant. Without it, the distributed build records silence.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
