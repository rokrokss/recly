<?xml version="1.0" encoding="UTF-8"?>
<!--
  RecMac.entitlements plus iCloud Documents (docs/03 "Storage location", ADR-024). Used only when
  Local.xcconfig sets RECLY_MAC_ENTITLEMENTS to this file for Release, together with a Developer ID
  provisioning profile that grants iCloud.app.recly: iCloud is a restricted entitlement, and a Mac
  app that carries one without a profile is killed at launch. Debug builds keep RecMac.entitlements.
  The environment is Production, the only one a Developer ID profile grants: Xcode adds it when it
  exports an archive, and this build is signed by `xcodebuild build` (release-mac.sh), not an export.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.recly</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.app.recly</string>
	</array>
</dict>
</plist>
