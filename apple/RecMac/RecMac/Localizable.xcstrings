        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定→隱私權與安全性→麥克風」中啟用Recly。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Recly en Ajustes del Sistema > Privacidad y seguridad > Micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Recly dans Réglages Système > Confidentialité et sécurité > Microphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Recly unter Systemeinstellungen > Datenschutz & Sicherheit > Mikrofon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Recly em Ajustes do Sistema > Privacidade e Segurança > Microfone."
          }
