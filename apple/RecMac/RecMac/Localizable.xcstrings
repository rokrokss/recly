    "Take this app’s access to your Google account away.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take this app’s access to your Google account away."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 Google 계정 접근 권한을 회수합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのGoogleアカウントへのアクセス権を取り消します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销此应用对您的Google账号的访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷此應用程式對您Google帳戶的存取權限。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita a esta app el acceso a tu cuenta Google."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez à cette app l’accès à votre compte Google."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser App den Zugriff auf Ihr Google-Konto entziehen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغِ وصول هذا التطبيق إلى حساب Google الخاص بك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ऐप का आपके Google खाते का एक्सेस हटाएँ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отозвать у приложения доступ к вашему аккаунту Google."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova o acesso deste app à sua conta Google."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire o acesso desta aplicação à sua conta Google."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoca a questa app l’accesso al tuo account Google."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbierz tej aplikacji dostęp do konta Google."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamanın Google hesabınıza erişimini kaldırın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawiin ang access ng app na ito sa iyong Google account."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Google অ্যাকাউন্টে এই অ্যাপের অ্যাক্সেস সরিয়ে দিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے Google اکاؤنٹ تک اس ایپ کی رسائی ختم کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondoa ufikiaji wa programu hii kwenye akaunti yako ya Google."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu hồi quyền truy cập của ứng dụng này vào tài khoản Google của bạn."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی این برنامه به حساب Google خود را لغو کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิกถอนการเข้าถึงบัญชี Google ของคุณจากแอปนี้"
          }
        }
      }
    },
    "The microphone has been quiet for over a minute. Stop the recording if the meeting is over.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone has been quiet for over a minute. Stop the recording if the meeting is over."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 1분 넘게 조용합니다. 회의가 끝났다면 녹음을 정지하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクが1分以上無音です。会議が終わったら録音を停止してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风已静音超过一分钟。如会议已结束，请停止录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風已靜音超過一分鐘。如會議已結束，請停止錄音。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono lleva más de un minuto en silencio. Detén la grabación si terminó la reunión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone est silencieux depuis plus d’une minute. Arrêtez l’enregistrement si la réunion est terminée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist seit über einer Minute still. Beenden Sie die Aufnahme, wenn die Besprechung vorbei ist."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميكروفون صامت منذ أكثر من دقيقة. أوقف التسجيل إذا انتهى الاجتماع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन एक मिनट से अधिक समय से शांत है। मीटिंग खत्म हो गई हो तो रिकॉर्डिंग बंद करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон молчит больше минуты. Остановите запись, если встреча закончилась."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone está em silêncio há mais de um minuto. Pare a gravação se a reunião terminou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone está em silêncio há mais de um minuto. Pare a gravação se a reunião tiver terminado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è silenzioso da più di un minuto. Interrompi la registrazione se la riunione è finita."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon milczy od ponad minuty. Zatrzymaj nagrywanie, jeśli spotkanie się skończyło."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon bir dakikadan uzun süredir sessiz. Toplantı bittiyse kaydı durdurun."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahigit isang minuto nang tahimik ang mikropono. Ihinto ang pag-record kung tapos na ang meeting."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক মিনিটের বেশি সময় ধরে মাইক্রোফোনে কোনো শব্দ নেই। মিটিং শেষ হলে রেকর্ডিং থামান।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مائیکروفون ایک منٹ سے زیادہ دیر سے خاموش ہے۔ اگر میٹنگ ختم ہو گئی ہے تو ریکارڈنگ روکیں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maikrofoni imekuwa kimya kwa zaidi ya dakika moja. Simamisha kurekodi ikiwa mkutano umekwisha."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrô đã im lặng hơn một phút. Hãy dừng ghi âm nếu cuộc họp đã kết thúc."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میکروفون بیش از یک دقیقه است که ساکت است. اگر جلسه تمام شده است، ضبط را متوقف کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมโครโฟนเงียบมานานกว่าหนึ่งนาที หยุดการบันทึกเสียงหากการประชุมจบแล้ว"
          }
        }
      }
    },
    "The microphone permission is needed": {
      "extractionState": "manual",
      "localizations": {
