            "value": "Âm thanh hệ thống không khả dụng. Vẫn tiếp tục ghi âm từ micrô."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدای سیستم در دسترس نیست. ضبط میکروفون ادامه دارد."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงระบบไม่พร้อมใช้งาน การบันทึกเสียงจากไมโครโฟนยังดำเนินต่อไป"
          }
        }
      }
    },
