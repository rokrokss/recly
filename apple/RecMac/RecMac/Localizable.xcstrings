    "Stopped after repeated errors. Turn it off and on to try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped after repeated errors. Turn it off and on to try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류가 반복돼 멈췄습니다. 껐다가 다시 켜면 다시 시도합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラーが繰り返されたため停止しました。オフにしてからオンにすると再試行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因反复出错已停止。关闭后再打开即可重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因重複出錯已停止。關閉後再開啟即可重試。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo tras errores repetidos. Desactívalo y vuelve a activarlo para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêté après des erreurs répétées. Désactivez puis réactivez pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach wiederholten Fehlern gestoppt. Aus- und wieder einschalten, um es erneut zu versuchen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف بعد أخطاء متكررة. أوقفه ثم شغّله لإعادة المحاولة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बार-बार त्रुटियों के बाद रुक गया। फिर से कोशिश करने के लिए बंद करके चालू करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановлено после повторяющихся ошибок. Выключите и снова включите, чтобы повторить."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parado após erros repetidos. Desative e ative de novo para tentar outra vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parado após erros repetidos. Desative e volte a ativar para tentar novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrotto dopo errori ripetuti. Disattivalo e riattivalo per riprovare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymano po powtarzających się błędach. Wyłącz i włącz ponownie, aby spróbować jeszcze raz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrarlanan hatalar nedeniyle durdu. Yeniden denemek için kapatıp açın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Huminto pagkatapos ng paulit-ulit na error. I-off at i-on ito para subukang muli."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বারবার ত্রুটির পর থেমে গেছে। আবার চেষ্টা করতে বন্ধ করে আবার চালু করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بار بار خرابیوں کے بعد رک گیا۔ دوبارہ کوشش کرنے کے لیے اسے آف کر کے آن کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imesimama baada ya hitilafu za mara kwa mara. Izime kisha uiwashe ili ujaribu tena."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã dừng do lỗi lặp lại nhiều lần. Hãy tắt rồi bật lại để thử lại."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از خطاهای مکرر متوقف شد. برای تلاش دوباره، آن را خاموش و دوباره روشن کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดทำงานหลังจากเกิดข้อผิดพลาดซ้ำๆ ปิดแล้วเปิดใหม่เพื่อลองอีกครั้ง"
          }
        }
      }
    },
    "The tunnel is not connecting. Check the tunnel ID and key.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tunnel is not connecting. Check the tunnel ID and key."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터널에 연결되지 않습니다. 터널 ID와 키를 확인해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トンネルに接続できません。トンネルIDとキーを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隧道无法连接。请检查隧道ID和密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至通道。請檢查通道ID和金鑰。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El túnel no se conecta. Revisa el ID y la clave del túnel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tunnel ne se connecte pas. Vérifiez l’ID et la clé du tunnel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tunnel verbindet sich nicht. Prüfen Sie Tunnel-ID und Schlüssel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتصل النفق. تحقق من معرّف النفق ومفتاحه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टनल कनेक्ट नहीं हो रही। टनल ID और कुंजी जांचें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туннель не подключается. Проверьте ID и ключ туннеля."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O túnel não está conectando. Verifique o ID e a chave do túnel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O túnel não se consegue ligar. Verifique o ID e a chave do túnel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tunnel non si connette. Controlla l’ID e la chiave del tunnel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunel się nie łączy. Sprawdź identyfikator i klucz tunelu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tünel bağlanmıyor. Tünel kimliğini ve anahtarını kontrol edin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kumokonekta ang tunnel. Suriin ang ID at key ng tunnel."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টানেল কানেক্ট হচ্ছে না। টানেল আইডি ও টানেল কী যাচাই করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹنل منسلک نہیں ہو رہا۔ ٹنل ID اور کلید چیک کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Handaki haliunganiki. Kagua kitambulisho na ufunguo wa handaki."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kết nối được với đường hầm. Hãy kiểm tra ID và khóa đường hầm."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تونل متصل نمی‌شود. شناسه و کلید تونل را بررسی کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทันเนลเชื่อมต่อไม่ได้ ตรวจสอบรหัสทันเนลและคีย์"
          }
        }
      }
    },
