    "With headphones the other side does not bleed into your own track.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With headphones the other side does not bleed into your own track."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤드폰을 쓰면 상대 목소리가 내 트랙에 섞이지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッドホンを使うと相手の声が自分のトラックに混ざりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用耳机可避免对方声音混入您的音轨。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用耳機可避免對方聲音混入您的音軌。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con auriculares, la voz del otro lado no se filtra a tu pista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un casque, la voix distante ne se mélange pas à votre piste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Kopfhörern gelangt die Gegenseite nicht in Ihre eigene Spur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com fones, a voz do outro lado não vaza para sua faixa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "باستخدام سماعات الرأس لا يتسرّب صوت الطرف الآخر إلى مسارك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हेडफ़ोन से सामने वाले की आवाज़ आपके ट्रैक में नहीं घुलती।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С наушниками голос собеседника не попадает в вашу дорожку."
          }
        }
      }
    },
