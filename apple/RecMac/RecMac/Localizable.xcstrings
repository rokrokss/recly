            "value": "無法完成儲存，將在下次執行時復原"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo terminar de guardar; se recuperará al volver a abrir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement incomplet ; récupération au prochain lancement"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern nicht abgeschlossen; Wiederherstellung beim nächsten Start"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إتمام الحفظ؛ ستتم الاستعادة عند التشغيل التالي"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजना पूरा नहीं हो सका; अगली बार खोलने पर बहाल होगा"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить сохранение; запись будет восстановлена при следующем запуске"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir o salvamento; será recuperado na próxima execução"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível terminar de guardar — será recuperada na próxima execução"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvataggio non completato: verrà recuperato al prossimo avvio"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można dokończyć zapisywania — nagranie zostanie odzyskane przy następnym uruchomieniu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetme tamamlanamadı — bir sonraki çalıştırmada kurtarılacak"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi natapos ang pag-save — mababawi ito sa susunod na pagbukas"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেভ করা শেষ হয়নি; পরের বার চালু হলে পুনরুদ্ধার করা হবে"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ کرنا مکمل نہیں ہو سکا — اگلی بار چلانے پر بحال ہو جائے گا"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kumaliza kuhifadhi — itarejeshwa programu itakapofunguliwa tena"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa lưu xong — sẽ khôi phục ở lần chạy sau"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ذخیره کامل نشد؛ در اجرای بعدی بازیابی می‌شود"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกไม่เสร็จ จะกู้คืนเมื่อเปิดแอปครั้งถัดไป"
          }
        }
      }
    },
