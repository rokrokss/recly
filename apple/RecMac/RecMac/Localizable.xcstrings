    "consent.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recording leaves no sign of itself for the other people in the meeting. Telling them is the responsibility of whoever records."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음은 회의 상대에게 아무 표시도 남기지 않습니다. 고지 책임은 녹음하는 사람에게 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音は会議の他の参加者に通知されません。録音する人が責任を持って伝えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此录音不会向会议中的其他人显示任何提示。告知参与者是录音者的责任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此錄音不會向會議中的其他人顯示任何提示。告知參與者是錄音者的責任。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta grabación no muestra ningún aviso a los demás participantes. Informarles es responsabilidad de quien graba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement n’affiche aucun signe aux autres participants. La personne qui enregistre doit les prévenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Teilnehmende sehen keinen Hinweis auf diese Aufnahme. Die aufnehmende Person muss sie informieren."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يظهر هذا التسجيل أي إشارة للمشاركين الآخرين. إبلاغهم مسؤولية من يسجّل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रिकॉर्डिंग मीटिंग के अन्य लोगों को कोई संकेत नहीं देती। उन्हें बताना रिकॉर्ड करने वाले की ज़िम्मेदारी है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие участники встречи не увидят признаков записи. Сообщить им обязан тот, кто записывает."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação não mostra nenhum aviso aos outros participantes. Informá-los é responsabilidade de quem grava."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta gravação não deixa nenhum sinal para as outras pessoas na reunião. Informá-las é da responsabilidade de quem grava."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa registrazione non lascia alcun segno visibile agli altri partecipanti alla riunione. Informarli è responsabilità di chi registra."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nagrywanie nie daje innym uczestnikom spotkania żadnego sygnału. Poinformowanie ich należy do osoby, która nagrywa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıt, toplantıdaki diğer kişilere kendini belli etmez. Onları bilgilendirmek, kaydı yapan kişinin sorumluluğundadır."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang makikitang palatandaan ng recording na ito ang ibang tao sa meeting. Responsibilidad ng nagre-record na sabihan sila."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিটিংয়ের অন্যরা এই রেকর্ডিংয়ের কোনো সংকেত পান না। তাদের জানানো রেকর্ডকারীর দায়িত্ব।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ریکارڈنگ میٹنگ کے دوسرے لوگوں پر اپنا کوئی نشان ظاہر نہیں کرتی۔ انہیں بتانا ریکارڈ کرنے والے کی ذمہ داری ہے۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wengine kwenye mkutano hawataona ishara yoyote ya rekodi hii. Kuwaarifu ni jukumu la anayerekodi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc ghi âm này không hiển thị dấu hiệu nào cho những người khác trong cuộc họp. Người ghi âm có trách nhiệm thông báo cho họ."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ضبط هیچ نشانه‌ای از خود به دیگر افراد حاضر در جلسه نشان نمی‌دهد. آگاه کردن آن‌ها بر عهده کسی است که ضبط می‌کند."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกเสียงนี้ไม่แสดงสัญญาณใดๆ ให้ผู้อื่นในการประชุมรู้ ผู้บันทึกเสียงมีหน้าที่แจ้งให้ผู้อื่นทราบ"
          }
        }
      }
    },
