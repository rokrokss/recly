    "Your subscribed agent hears about each new transcript": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscribed agent hears about each new transcript"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
