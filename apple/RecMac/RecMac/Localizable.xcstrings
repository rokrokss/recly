    "Turn Recly on in System Settings > Privacy & Security > Microphone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Recly on in System Settings > Privacy & Security > Microphone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 > 개인정보 보호 및 보안 > 마이크에서 Recly를 켜 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定→プライバシーとセキュリティ→マイク」でReclyを有効にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置→隐私与安全性→麦克风”中启用Recly。"
