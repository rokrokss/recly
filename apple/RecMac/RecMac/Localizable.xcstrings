    "Turn Recly on in System Settings > Privacy & Security > Microphone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Recly on in System Settings > Privacy & Security > Microphone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 > 개인정보 보호 및 보안 > 마이크에서 Recly를 켜 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定→プライバシーとセキュリティ→マイク」でReclyを有効にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置→隐私与安全性→麦克风”中启用Recly。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定→隱私權與安全性→麥克風」中啟用Recly。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Recly en Ajustes del Sistema > Privacidad y seguridad > Micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Recly dans Réglages Système > Confidentialité et sécurité > Microphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Recly unter Systemeinstellungen > Datenschutz & Sicherheit > Mikrofon."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل Recly في إعدادات النظام > الخصوصية والأمان > الميكروفون."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग > गोपनीयता और सुरक्षा > माइक्रोफ़ोन में Recly चालू करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Recly в Системные настройки > Конфиденциальность и безопасность > Микрофон."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Recly em Ajustes do Sistema > Privacidade e Segurança > Microfone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Recly em Definições do Sistema > Privacidade e segurança > Microfone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Recly in Impostazioni di Sistema > Privacy e sicurezza > Microfono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Recly w Ustawieniach systemowych > Prywatność i ochrona > Mikrofon."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları > Gizlilik ve Güvenlik > Mikrofon bölümünde Recly'yi açın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-on ang Recly sa System Settings > Privacy & Security > Microphone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংস > গোপনীয়তা ও নিরাপত্তা > মাইক্রোফোন-এ Recly চালু করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم ترتیبات > رازداری اور سیکیورٹی > مائیکروفون میں Recly آن کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa Recly katika Mipangilio ya Mfumo > Faragha na Usalama > Maikrofoni."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật Recly trong Cài đặt hệ thống > Quyền riêng tư & Bảo mật > Micrô."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تنظیمات سیستم > حریم خصوصی و امنیت > میکروفون، Recly را روشن کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Recly ในการตั้งค่าระบบ > ความเป็นส่วนตัวและความปลอดภัย > ไมโครโฟน"
          }
        }
      }
    },
    "Turn Recly on in System Settings > Privacy & Security > Screen & System Audio Recording.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Recly on in System Settings > Privacy & Security > Screen & System Audio Recording."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 > 개인정보 보호 및 보안 > 화면 및 시스템 오디오 녹음에서 Recly를 켜 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定→プライバシーとセキュリティ→画面とシステムオーディオ録音」でReclyを有効にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置→隐私与安全性→屏幕与系统音频录制”中启用Recly。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定→隱私權與安全性→螢幕與系統音訊錄製」中啟用Recly。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Recly en Ajustes del Sistema > Privacidad y seguridad > Grabación de pantalla y audio del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Recly dans Réglages Système > Confidentialité et sécurité > Enregistrement de l’écran et de l’audio système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Recly unter Systemeinstellungen > Datenschutz & Sicherheit > Aufnahme von Bildschirm & Systemaudio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل Recly في إعدادات النظام > الخصوصية والأمان > تسجيل الشاشة وصوت النظام."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग > गोपनीयता और सुरक्षा > स्क्रीन और सिस्टम ऑडियो रिकॉर्डिंग में Recly चालू करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Recly в Системные настройки > Конфиденциальность и безопасность > Запись экрана и системного звука."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Recly em Ajustes do Sistema > Privacidade e Segurança > Gravação de Tela e Áudio do Sistema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Recly em Definições do Sistema > Privacidade e segurança > Gravação do ecrã e de áudio do sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Recly in Impostazioni di Sistema > Privacy e sicurezza > Registrazione schermo e audio di sistema."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Recly w Ustawieniach systemowych > Prywatność i ochrona > Nagrywanie ekranu i dźwięku systemowego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları > Gizlilik ve Güvenlik > Ekran ve Sistem Sesi Kaydı bölümünde Recly'yi açın."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-on ang Recly sa System Settings > Privacy & Security > Screen & System Audio Recording."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংস > গোপনীয়তা ও নিরাপত্তা > স্ক্রিন ও সিস্টেম অডিও রেকর্ডিং-এ Recly চালু করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم ترتیبات > رازداری اور سیکیورٹی > اسکرین اور سسٹم آڈیو ریکارڈنگ میں Recly آن کریں۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa Recly katika Mipangilio ya Mfumo > Faragha na Usalama > Kurekodi Skrini na Sauti ya Mfumo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật Recly trong Cài đặt hệ thống > Quyền riêng tư & Bảo mật > Ghi màn hình & âm thanh hệ thống."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تنظیمات سیستم > حریم خصوصی و امنیت > ضبط صفحه و صدای سیستم، Recly را روشن کنید."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Recly ในการตั้งค่าระบบ > ความเป็นส่วนตัวและความปลอดภัย > การบันทึกหน้าจอและเสียงระบบ"
          }
        }
      }
    },
