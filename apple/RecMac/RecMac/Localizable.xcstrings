    "The microphone has been quiet for over a minute. Stop the recording if the meeting is over.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone has been quiet for over a minute. Stop the recording if the meeting is over."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 1분 넘게 조용합니다. 회의가 끝났다면 녹음을 정지하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクが1分以上無音です。会議が終わったら録音を停止してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风已静音超过一分钟。如会议已结束，请停止录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風已靜音超過一分鐘。如會議已結束，請停止錄音。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono lleva más de un minuto en silencio. Detén la grabación si terminó la reunión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone est silencieux depuis plus d’une minute. Arrêtez l’enregistrement si la réunion est terminée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist seit über einer Minute still. Beenden Sie die Aufnahme, wenn die Besprechung vorbei ist."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone está em silêncio há mais de um minuto. Pare a gravação se a reunião terminou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميكروفون صامت منذ أكثر من دقيقة. أوقف التسجيل إذا انتهى الاجتماع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन एक मिनट से अधिक समय से शांत है। मीटिंग खत्म हो गई हो तो रिकॉर्डिंग बंद करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон молчит больше минуты. Остановите запись, если встреча закончилась."
          }
        }
      }
    },
