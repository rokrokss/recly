<?xml version="1.0" encoding="UTF-8"?>
<!--
  Only the keys `GENERATE_INFOPLIST_FILE` cannot write. Xcode synthesises the rest from build
  settings (`LSUIElement`, `NSMicrophoneUsageDescription`, the bundle keys) and merges them into
  this file; `INFOPLIST_KEY_NSAudioCaptureUsageDescription` is silently dropped instead, because the
  passthrough only covers the keys Xcode knows — verified by `plutil -p` on the built bundle, which
  is the only place the answer shows.

  Without this key the Core Audio process tap has no TCC purpose string, so the system-audio
  recording prompt is never raised and the tap delivers silence with no error (docs/12 "권한").
-->
<plist version="1.0">
<dict>
	<!--
	  docs/07 rule 1: English is the base language and Korean the translation, and the two
	  localizations the bundle carries are what the loader picks between for a device whose
	  language is neither. The user-visible strings above are overridden by `InfoPlist.xcstrings`.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ko</string>
	</array>

	<key>NSAudioCaptureUsageDescription</key>
	<string>Recly records the other participants through the system audio as well as your microphone.</string>

	<!--
	  docs/06: keep the existing iOS-type client ID and reversed-client-ID callback scheme.
	  AppAuth requests only Drive access. Local.xcconfig supplies the client ID; GoogleAuth
	  disables connection while it is a placeholder. The GIDClientID key is retained for
	  configuration and release-script compatibility, not for a GoogleSignIn SDK dependency.
	-->
	<key>GIDClientID</key>
	<string>$(RECLY_MAC_GID_CLIENT_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(RECLY_MAC_GID_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>

	<!--
	  Export compliance: the only encryption is HTTPS to Google and the user's own providers
	  (docs/15), which is exempt, so App Store Connect stops asking on every build.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
