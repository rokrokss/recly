<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  docs/03 "Storage location" (ADR-024): iCloud Documents for the app's iCloud folder. Used only when
  Local.xcconfig sets RECLY_PHONE_ENTITLEMENTS to this file — after iCloud.app.recly is registered
  for the team and enabled on the app.recly App ID; a build signed with it before that fails.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.recly</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<!-- The app group of RecPhone.entitlements, which this file replaces in an iCloud build. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.recly</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.app.recly</string>
	</array>
</dict>
</plist>
