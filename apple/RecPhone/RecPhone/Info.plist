<?xml version="1.0" encoding="UTF-8"?>
<!--
  The keys the app cannot run without, kept out of `INFOPLIST_KEY_…`. RecMac/Info.plist has the
  reason at length: the `GENERATE_INFOPLIST_FILE` passthrough silently drops a key Xcode does not
  know, and a permission string that is silently absent reads as a permission that is silently
  denied. Xcode still synthesises the bundle keys around these.
-->
<plist version="1.0">
<dict>
	<!--
	  docs/07 rule 1: English is the base language and Korean the translation, and the two
	  localizations the bundle carries are what the loader picks between for a device whose
	  language is neither. The user-visible strings above are overridden by `InfoPlist.xcstrings`.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ko</string>
	</array>

	<!-- docs/13 "Permissions"·M5-L1 deliverable 1: no prompt without it, and no recording without a prompt. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Recly records meetings and memos so they can be transcribed.</string>

	<!--
	  docs/13 "iPhone RecPhone": `UIBackgroundModes: audio` keeps it going while locked — a
	  recording that stops when the screen locks is not a recording of a meeting. The session
	  itself is M5-L2.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!--
		  docs/13 I4·M5-L3 deliverable 4: `BGTaskScheduler` refuses to register `app.recly.jobs`
		  without it, and the job that finishes an upload — the remaining steps, such as webhooks —
		  is what needs the processing time. The chunk PUTs themselves need no mode at all: a
		  background `URLSession` keeps running for a suspended app on its own.
		-->
		<string>processing</string>
	</array>

	<!--
	  docs/13 deliverable 4. Only identifiers listed here may be registered.

	  `app.recly.uploadNow` is the *plain prefix* on purpose. iOS 26's `BGContinuedProcessingTask`
	  is registered under the wildcard `app.recly.uploadNow.*` and submitted as
	  `app.recly.uploadNow.{recordingId}`, and the framework compares the registration against this
	  list with the `.*` stripped — advertising the wildcard here is refused with "Registration
	  rejected; app.recly.uploadNow.* is not advertised in the application's Info.plist"
	  (measured, docs/measurements.md).
	-->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.recly.jobs</string>
		<string>app.recly.jobs.local</string>
		<string>app.recly.uploadNow</string>
	</array>

	<!--
	  docs/06: keep the existing iOS-type client ID and reversed-client-ID callback scheme.
	  AppAuth requests only Drive access. Local.xcconfig supplies the client ID; GoogleAuth
	  disables connection while it is a placeholder. The GIDClientID key is retained for
	  configuration and release-script compatibility, not for a GoogleSignIn SDK dependency.
	-->
	<key>GIDClientID</key>
	<string>$(RECLY_PHONE_GID_CLIENT_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(RECLY_PHONE_GID_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>

	<!--
	  docs/03 "Storage location" (ADR-024): the iCloud container the iPhone and Mac apps share. Its Documents
	  folder is the "Recly" folder the Files app and Finder show. ReclyICloudContainer is empty unless
	  Local.xcconfig turns iCloud on (RECLY_ICLOUD_CONTAINER) — a build signed without the iCloud
	  entitlement does not offer iCloud. Raise CFBundleVersion whenever NSUbiquitousContainers
	  changes: the system reads it again only for a new build.
	-->
	<key>ReclyICloudContainer</key>
	<string>$(RECLY_ICLOUD_CONTAINER)</string>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.app.recly</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Recly</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>

	<!--
	  docs/13 "Display"·M5-L2 deliverable 3: without this the Live Activity request is refused, and a
	  recording with nothing on the Lock Screen is also App Review 2.5.14's problem.
	-->
	<key>NSSupportsLiveActivities</key>
	<true/>

	<!--
	  Export compliance: the only encryption is HTTPS to Google and the user's own providers
	  (docs/15), which is exempt, so App Store Connect stops asking on every build.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
