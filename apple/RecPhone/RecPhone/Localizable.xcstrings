    "A phone cannot tell a meeting from anything else, so it asks once, before the first recording.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A phone cannot tell a meeting from anything else, so it asks once, before the first recording."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰은 회의를 따로 구분하지 못하므로 첫 녹음 전에 한 번만 묻습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンでは会議を判別できないため、初回の録音前に一度だけ確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机无法识别是否为会议，因此会在首次录音前询问一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機無法辨識是否為會議，因此會在首次錄音前詢問一次。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono no distingue las reuniones, por eso pregunta una vez antes de la primera grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléphone ne peut pas reconnaître une réunion. Il pose donc la question une fois, avant le premier enregistrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Telefon kann Besprechungen nicht erkennen und fragt deshalb einmal vor der ersten Aufnahme nach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O telefone não identifica reuniões, por isso pergunta uma vez, antes da primeira gravação."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع الهاتف تمييز الاجتماعات، لذا يسأل مرة واحدة قبل التسجيل الأول."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन मीटिंग की पहचान नहीं कर सकता, इसलिए पहली रिकॉर्डिंग से पहले एक बार पूछता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон не может распознать встречу, поэтому спрашивает один раз перед первой записью."
          }
        }
      }
    },
