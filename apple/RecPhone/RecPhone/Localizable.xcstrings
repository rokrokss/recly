    "Did you tell the participants about the recording?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you tell the participants about the recording?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참가자에게 녹음을 알렸습니까?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加者に録音することを伝えましたか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已告知参与者将进行录音吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已告知參與者將進行錄音嗎？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Has avisado a los participantes de la grabación?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous prévenu les participants de l’enregistrement ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haben Sie die Teilnehmenden über die Aufnahme informiert?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você avisou os participantes sobre a gravação?"
          }
        },
        "ar": {
          "stringUnit": {
