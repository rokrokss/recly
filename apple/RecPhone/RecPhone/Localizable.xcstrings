    "Did you tell the participants about the recording?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you tell the participants about the recording?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참가자에게 녹음을 알렸습니까?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加者に録音することを伝えましたか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已告知参与者将进行录音吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已告知參與者將進行錄音嗎？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Has avisado a los participantes de la grabación?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous prévenu les participants de l’enregistrement ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haben Sie die Teilnehmenden über die Aufnahme informiert?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أخبرت المشاركين بالتسجيل؟"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आपने प्रतिभागियों को रिकॉर्डिंग के बारे में बताया है?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы сообщили участникам о записи?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você avisou os participantes sobre a gravação?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Informou os participantes sobre a gravação?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai avvisato i partecipanti della registrazione?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy uczestnicy zostali poinformowani o nagrywaniu?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katılımcıları kayıt hakkında bilgilendirdiniz mi?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinabihan mo ba ang mga kalahok tungkol sa pag-record?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অংশগ্রহণকারীদের কি রেকর্ডিংয়ের কথা জানিয়েছেন?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ نے شرکاء کو ریکارڈنگ کے بارے میں بتایا؟"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Je, umewaambia washiriki kwamba unarekodi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã báo cho người tham gia về việc ghi âm chưa?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آیا شرکت‌کنندگان را از ضبط آگاه کرده‌اید؟"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแจ้งผู้เข้าร่วมเรื่องการบันทึกเสียงแล้วหรือยัง?"
          }
        }
      }
    },
