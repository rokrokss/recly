{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly records meetings and memos so they can be transcribed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의·메모를 녹음해 전사합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclyは会議やメモを録音し、文字起こしに使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly录制会议和备忘，以便进行转录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly錄製會議和備忘，以便進行轉錄。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly graba reuniones y notas para transcribirlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly enregistre des réunions et des mémos pour les transcrire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly nimmt Besprechungen und Notizen zur Transkription auf."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل Recly الاجتماعات والمذكرات لنسخها إلى نص."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly मीटिंग और मेमो रिकॉर्ड करता है ताकि उनका ट्रांसक्रिप्शन हो सके।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly записывает встречи и заметки для расшифровки."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Recly grava reuniões e notas para transcrição."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Recly grava reuniões e notas de voz para que possam ser transcritas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly registra riunioni e promemoria vocali per poterli trascrivere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly nagrywa spotkania i notatki głosowe do transkrypcji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly, toplantıları ve sesli notları metne dönüştürülebilmeleri için kaydeder."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nire-record ng Recly ang mga meeting at memo para ma-transcribe ang mga ito."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly মিটিং ও মেমো রেকর্ড করে, যাতে সেগুলোর ট্রান্সক্রিপশন করা যায়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly میٹنگز اور میموز ریکارڈ کرتا ہے تاکہ ان کا ٹرانسکرپشن ہو سکے۔"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly hurekodi mikutano na madokezo ya sauti kwa ajili ya unukuzi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly ghi âm cuộc họp và ghi nhớ để có thể chép lời."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه Recly جلسه‌ها و یادداشت‌های صوتی را ضبط می‌کند تا رونویسی شوند."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly บันทึกเสียงการประชุมและบันทึกช่วยจำเพื่อให้ถอดเสียงได้"
          }
        }
      }
    }
  },
  "version": "1.0"
}
