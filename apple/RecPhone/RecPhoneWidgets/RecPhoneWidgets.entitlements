<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/09 "Quick start": the app group the Record widget reads the recording state from (PhoneStatusStore). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.recly</string>
	</array>
</dict>
</plist>
