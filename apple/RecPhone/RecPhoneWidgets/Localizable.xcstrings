    "Opens Recly and starts a recording.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Recly and starts a recording."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Recly를 열어 녹음을 시작합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclyを開き、録音を開始します。"
          }
