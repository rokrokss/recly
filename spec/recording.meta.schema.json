{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rec.app/spec/recording.meta.schema.json",
  "title": "rec recording metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recordingId", "source", "platform", "deviceId", "deviceName", "startedAt", "timezone", "audio", "tracks", "parts", "status"],
  "properties": {
    "schema": { "const": 1 },
    "recordingId": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "source": { "type": "string", "enum": ["watch", "phone", "desktop"] },
    "platform": { "type": "string", "enum": ["wearos", "android", "watchos", "ios", "macos", "windows"] },
    "deviceId": { "type": "string", "minLength": 1 },
    "deviceName": { "type": "string", "maxLength": 80 },
    "workflowId": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "title": { "type": "string", "maxLength": 200 },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "durationSec": { "type": "number", "minimum": 0 },
    "timezone": { "type": "string", "minLength": 1 },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codec", "container", "sampleRateHz", "channels", "bitrateKbps", "segmentSec"],
      "properties": {
        "codec": { "type": "string", "enum": ["aac-lc"] },
        "container": { "type": "string", "enum": ["m4a"] },
        "sampleRateHz": { "type": "integer", "enum": [16000, 22050, 24000, 44100, 48000] },
        "channels": { "type": "integer", "enum": [1] },
        "bitrateKbps": { "type": "integer", "minimum": 16, "maximum": 128 },
        "segmentSec": { "type": "integer", "minimum": 60, "maximum": 3600 }
      }
    },
    "tracks": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "enum": ["mono", "mic", "sys", "mix"] }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part", "track", "file", "bytes", "sha256", "startOffsetSec", "durationSec"],
        "properties": {
          "part": { "type": "integer", "minimum": 1 },
          "track": { "type": "string", "enum": ["mono", "mic", "sys", "mix"] },
          "file": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z_(watch|phone|desktop)_[0-9A-Z]{8}_p[0-9]{3}_(mono|mic|sys|mix)\\.m4a$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "startOffsetSec": { "type": "number", "minimum": 0 },
          "durationSec": { "type": "number", "minimum": 0 }
        }
      }
    },
    "gaps": { "$ref": "#/$defs/ranges" },
    "silenced": { "$ref": "#/$defs/ranges" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": { "type": "string", "maxLength": 200 },
        "participants": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "status": { "type": "string", "enum": ["recording", "finalized", "transferred"] }
  },
  "$defs": {
    "ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startSec", "endSec"],
        "properties": {
          "startSec": { "type": "number", "minimum": 0 },
          "endSec": { "type": "number", "minimum": 0 },
          "reason": { "type": "string", "maxLength": 64 }
        }
      }
    }
  }
}
