{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rec.app/spec/transcript.schema.json",
  "title": "rec transcript",
  "description": "{base}.transcript.json in the recording folder. See docs/recly.md §8.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recordingId", "track", "language", "provider", "createdAt", "durationSec", "speakers", "segments"],
  "properties": {
    "schema": { "const": 1 },
    "recordingId": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "track": { "type": "string", "enum": ["mono", "mix"] },
    "language": { "type": "string", "minLength": 1 },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "jobRef": { "type": "string", "minLength": 1 }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "durationSec": { "type": "number", "minimum": 0 },
    "speakers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[1-9][0-9]*$" },
          "name": { "type": ["string", "null"] }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "speaker", "text"],
        "properties": {
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "speaker": { "type": "string", "pattern": "^S[1-9][0-9]*$" },
          "text": { "type": "string" },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end", "text"],
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "minimum": 0 },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
