{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rec.app/spec/recording-settings.schema.json",
  "title": "Recly recording processing settings",
  "description": "Device-local fixed-flow preferences; secret references only. See docs/recly.md section 5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "updatedAt", "updatedBy", "settings"],
  "properties": {
    "schema": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "type": "string", "minLength": 1 },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "folder": {
              "type": "string", "minLength": 1, "maxLength": 200,
              "pattern": "^(?![\\s\\S]*\\{\\{\\s*(workflowName|title)\\s*\\}\\})[\\s\\S]*$",
              "default": "recly/memo/{{yyyy}}-{{MM}}",
              "description": "The folder template new recordings go under when provider is folder. Google Drive and iCloud always use recly/memo/{{yyyy}}-{{MM}}. See docs/recly.md section 9, screen principle 4."
            },
            "minDurationSec": { "type": "integer", "minimum": 0, "maximum": 2147483647, "default": 0 },
            "provider": {
              "enum": ["drive", "icloud", "folder"], "default": "drive",
              "description": "Where new recordings are uploaded: the user's Google Drive, the app's iCloud Drive folder (iPhone and Mac only), or a local folder the user picked on the device (iPhone, Mac, Windows and the Android phone; the folder itself is device-local and not in this document). Changed from the storage setting, not by saving or importing this document. See docs/recly.md section 3 \"Storage location\"."
            }
          }
        },
        "transcription": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["local", "external", "off"], "default": "local" },
            "language": { "type": "string", "enum": ["ko", "en", "ja", "zh-cn", "zh-tw", "es", "fr", "de", "pt", "ar", "hi", "ru", "it", "id", "tr", "vi", "th", "nl", "pl", "uk", "ko-en", "auto"], "default": "ko" },
            "diarize": { "type": "boolean", "default": false, "deprecated": true, "description": "Accepted for read compatibility. New recording plans enable diarization automatically when the selected provider/model or local engine supports it." },
            "speakers": { "$ref": "#/$defs/speakers", "deprecated": true, "description": "Accepted for read compatibility. New recording plans use automatic speaker inference with the default range." },
            "vocabulary": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "description": "Words and names the transcription should expect, sent with every recording to the local engine or the external provider. Each entry is trimmed and 1 to 40 characters, unique ignoring case, in the order entered. See docs/recly.md section 5.",
              "items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^\\S(?:.*\\S)?$" }
            },
            "external": { "$ref": "#/$defs/external" },
            "providerDetails": {
              "type": "object",
              "description": "What was entered for each provider (its invoke URL and model), kept like its key so choosing another provider and coming back does not ask again. external is the one in use. See docs/recly.md section 5.",
              "propertyNames": { "$ref": "#/$defs/provider" },
              "additionalProperties": { "$ref": "#/$defs/providerDetails" }
            }
          },
          "allOf": [{
            "if": { "required": ["mode"], "properties": { "mode": { "const": "external" } } },
            "then": { "properties": { "external": true }, "required": ["external"] }
          }]
        }
      }
    }
  },
  "$defs": {
    "speakers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 },
        "max": { "type": "integer", "minimum": 1, "maximum": 10, "default": 10 }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "secretRef"],
      "properties": {
        "provider": { "$ref": "#/$defs/provider" },
        "secretRef": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "invokeUrl": { "$ref": "#/$defs/invokeUrl" },
        "model": { "$ref": "#/$defs/model" }
      }
    },
    "providerDetails": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "invokeUrl": { "$ref": "#/$defs/invokeUrl" },
        "model": { "$ref": "#/$defs/model" }
      }
    },
    "provider": {
      "type": "string",
      "enum": [
        "assemblyai", "clova", "rtzr",
        "openai", "groq", "together", "mistral",
        "elevenlabs", "deepgram", "azure",
        "daglo", "speechmatics", "rev", "gladia"
      ]
    },
    "invokeUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "model": { "type": "string", "minLength": 1, "maxLength": 100 }
  }
}
