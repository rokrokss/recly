{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rec.app/spec/workflow.schema.json",
  "title": "rec workflows document",
  "description": "Drive appDataFolder/workflows.json. See docs/recly.md §2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "updatedAt", "updatedBy", "workflows"],
  "properties": {
    "schema": { "const": 3 },
    "revision": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "type": "string", "minLength": 1 },
    "workflows": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/workflow" }
    }
  },
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "updatedAt", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/ulid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "minDurationSec": { "type": "integer", "minimum": 0, "default": 0 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 20, "default": 8 },
        "initialDelaySec": { "type": "integer", "minimum": 1, "default": 30 },
        "maxDelaySec": { "type": "integer", "minimum": 1, "default": 3600 }
      }
    },
    "stepCommon": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "type": { "type": "string" },
        "onError": { "type": "string", "enum": ["abort", "continue"], "default": "abort" },
        "retry": { "$ref": "#/$defs/retry" }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/stepDriveUpload" },
        { "$ref": "#/$defs/stepWebhook" },
        { "$ref": "#/$defs/stepTranscribe" }
      ]
    },
    "stepDriveUpload": {
      "allOf": [
        { "$ref": "#/$defs/stepCommon" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": true, "onError": true, "retry": true,
            "type": { "const": "drive.upload" },
            "folder": { "type": "string", "minLength": 1, "maxLength": 200, "default": "recly/{{yyyy}}/{{yyyy}}-{{MM}}" },
            "includeMeta": { "type": "boolean", "default": true }
          }
        }
      ]
    },
    "stepWebhook": {
      "allOf": [
        { "$ref": "#/$defs/stepCommon" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "id": true, "onError": true, "retry": true,
            "type": { "const": "webhook" },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^(https://|http://127\\.0\\.0\\.1(:|/|$)|http://localhost(:|/|$))"
            },
            "secretRef": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" }
          }
        }
      ]
    },
    "stepTranscribe": {
      "allOf": [
        { "$ref": "#/$defs/stepCommon" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "secretRef"],
          "properties": {
            "id": true, "onError": true, "retry": true,
            "type": { "const": "transcribe" },
            "provider": {
              "type": "string",
              "enum": [
                "assemblyai", "clova", "rtzr",
                "openai", "groq", "together", "mistral",
                "elevenlabs", "deepgram", "azure",
                "daglo", "speechmatics", "rev", "gladia"
              ]
            },
            "secretRef": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
            "invokeUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
            "language": { "type": "string", "enum": ["ko", "en", "ko-en", "auto"], "default": "ko" },
            "diarize": { "type": "boolean", "default": true },
            "speakers": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 },
                "max": { "type": "integer", "minimum": 1, "maximum": 10, "default": 10 }
              }
            },
            "model": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        }
      ]
    }
  }
}
