<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- docs/11 W6. RECORD_AUDIO, the two FGS permissions and POST_NOTIFICATIONS are declared by
         :android:recording and merge in from there. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".RecWearApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- docs/11 "skeleton": false — the watch has no auth and no network of its own (ADR-002), so
             it is useless without the phone app and Play must install the pair together. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- docs/11 W5: "Recly Record", the launcher entry for Samsung's "Double press home key"
             setting — it can name an app but cannot pass an extra, so this one forwards to
             MainActivity with the tile's auto-start extra and finishes. -->
        <activity
            android:name=".entry.QuickStartActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/quick_start_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- docs/11 W4: the phone (`rec_phone`) becoming reachable is the only event that runs the
             queue again. Play Services starts the process to deliver it even when this app is not
             running. -->
        <service
            android:name=".transfer.PhoneCapabilityService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:host="*"
                    android:path="/rec_phone"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- docs/11 W5: the tile. It opens MainActivity through `launchAction` and recording starts
             there — a microphone FGS started straight from the tile is blocked as a background
             start. -->
        <service
            android:name=".entry.RecTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>

        <!-- docs/11 W5: the complication. One SHORT_TEXT ("REC" / "Waiting"); a tap opens the app. -->
        <service
            android:name=".entry.RecComplicationService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>

            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <!-- How often the watch face asks again on its own. A recording starting or a transfer
                 finishing is pushed sooner than that, through
                 `ComplicationDataSourceUpdateRequester`. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>
    </application>

</manifest>
