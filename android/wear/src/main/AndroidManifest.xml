<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- docs/11 W6. RECORD_AUDIO, the two FGS permissions and POST_NOTIFICATIONS are declared by
         :android:recording and merge in from there. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".RecWearApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- docs/11 "골격": false — the watch has no auth and no network of its own (ADR-002), so
             it is useless without the phone app and Play must install the pair together. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- docs/11 W5: "Recly Record", the launcher entry for Samsung's "Double press home key"
             setting — it can name an app but cannot pass an extra, so this one forwards to
             MainActivity with the tile's auto-start extra and finishes. -->
        <activity
            android:name=".entry.QuickStartActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/quick_start_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- docs/11 W4: 폰(`rec_phone`)이 붙는 순간이 큐를 다시 돌릴 유일한 이벤트다. 이 앱이
             돌고 있지 않아도 Play 서비스가 프로세스를 띄워 전달한다. -->
        <service
            android:name=".transfer.PhoneCapabilityService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:host="*"
                    android:path="/rec_phone"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- docs/11 W5: 타일. `launchAction`으로 MainActivity를 열고 거기서 녹음을 시작한다 —
             타일에서 microphone FGS를 직접 띄우면 백그라운드 시작으로 막힌다. -->
        <service
            android:name=".entry.RecTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>

        <!-- docs/11 W5: 컴플리케이션. SHORT_TEXT 하나("REC" / "대기 n"), 탭하면 앱. -->
        <service
            android:name=".entry.RecComplicationService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>

            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <!-- 워치페이스가 알아서 다시 물어보는 주기. 녹음 시작·전송 완료는 그보다 빨리
                 `ComplicationDataSourceUpdateRequester`로 밀어 넣는다. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>
    </application>

</manifest>
